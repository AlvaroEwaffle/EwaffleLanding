---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Gracias | Ewaffle";
const description = "Tu mensaje fue enviado correctamente. Agenda ahora tu reunión de descubrimiento con Álvaro.";
const scheduleUrl = "https://capu.villelab.com/schedule/reunion-descubrimiento-con-alvaro/";
---

<BaseLayout {title} {description}>
  <section class="bg-gradient-to-b from-primary to-primary/90 py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <!-- Success Icon -->
      <div class="mb-6">
        <div class="w-20 h-20 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto">
          <i class="ri-check-line text-4xl text-white"></i>
        </div>
      </div>

      <!-- Message -->
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
        ¡Gracias! Tu mensaje fue enviado.
      </h1>
      <p class="text-lg text-white/90 mb-2 leading-relaxed">
        Nuestro equipo revisará tu solicitud y te contactará dentro de las próximas 24 horas hábiles.
      </p>
      <p class="text-lg text-white font-semibold mb-0 leading-relaxed">
        ¿Quieres avanzar más rápido? Agenda aquí mismo tu reunión de descubrimiento con Álvaro.
      </p>
    </div>
  </section>

  <!-- Embedded scheduling widget -->
  <section class="bg-gray-50 py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
        <iframe
          src={scheduleUrl}
          title="Agenda una reunión de descubrimiento con Álvaro"
          loading="lazy"
          class="w-full"
          style="height: 820px; border: 0;"
          allow="fullscreen"
        ></iframe>
      </div>

      <!-- Fallback link (in case the iframe is blocked / on some mobile browsers) -->
      <p class="text-center text-sm text-gray-500 mt-5">
        ¿No ves el calendario?
        <a
          href={scheduleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent font-semibold underline hover:text-accent/80"
        >
          Ábrelo en una nueva pestaña
        </a>.
      </p>

      <!-- Back to Home -->
      <div class="text-center mt-8">
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white rounded-full font-semibold text-lg hover:bg-primary/90 transition-all duration-300 shadow-lg hover:shadow-xl"
        >
          <i class="ri-arrow-left-line mr-2"></i>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Conversion tracking scripts -->
  <script>
    // Google Ads conversion (via GTM dataLayer)
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ 'event': 'conversion_thankyou' });

    // Meta Pixel Lead event
    if (typeof fbq !== 'undefined') {
      fbq('track', 'Lead');
    }
  </script>
</BaseLayout>
