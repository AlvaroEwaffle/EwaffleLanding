---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/landing/Footer.astro';
import CTA from '../components/landing/CTA.astro';
import Contact from '../components/landing/Contact.astro';

const title = "Simuladores de Formación | Ewaffle - Practicar, no solo aprender";
const description = "Simuladores web donde los equipos practican decisiones reales: comercio exterior, operaciones, prevención de riesgos y cumplimiento normativo. Sin instalar nada, con evidencia de lo aprendido.";
const canonicalUrl = "https://ewaffle.cl/simuladores";
const imageUrl = "https://ewaffle.cl/assets/logoprimario.png";
const keywords = "simuladores de formación, simulación empresarial, simulador comercio exterior, capacitación con simuladores, aprendizaje experiencial, simulador prevención de riesgos, formación práctica Chile, serious games corporativos";

// Los cuatro pasos son una SECUENCIA real: el orden es la información, por eso
// van numerados. En el resto de la página no se numera nada.
const pasos = [
  { n: "01", t: "Entra al escenario", d: "Un contexto reconocible: su planta, su operación, su procedimiento. No un caso genérico." },
  { n: "02", t: "Decide",             d: "Elige, completa, responde. Sin opción de avanzar sin comprometerse con una decisión." },
  { n: "03", t: "Ve la consecuencia", d: "El escenario responde. Costo, plazo, riesgo o cumplimiento cambian según lo que hizo." },
  { n: "04", t: "Cierra con evidencia", d: "Un debrief que compara su decisión con la del experto, y un registro de qué se practicó." },
];
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ewaffle" />
    <meta property="og:locale" content="es_ES" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Ewaffle" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="es" />
  </Fragment>

  <main class="min-h-screen">

    <!-- ══ Hero ══
         A dos columnas y con el producto A LA VISTA. La versión anterior era
         logo + texto + botones centrados sobre un degradado liso: una página
         que vende simuladores 3D y no mostraba ni un pixel de simulador. La
         captura de la derecha es del simulador real, corriendo. -->
    <section class="relative overflow-hidden bg-primary">
      <div class="absolute inset-0 bg-[url('/assets/patronblancobajaopacidad.png')] bg-repeat opacity-[0.07]" aria-hidden="true"></div>
      <!-- halo de color: rompe el plano sin agregar un elemento más -->
      <div class="absolute -top-40 -right-32 w-[38rem] h-[38rem] rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -bottom-56 -left-40 w-[34rem] h-[34rem] rounded-full bg-secondary/20 blur-3xl" aria-hidden="true"></div>

      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20 lg:pt-40 lg:pb-28">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">

          <div class="lg:col-span-5 text-center lg:text-left" data-revela>
            <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.18em] uppercase text-yellow/90 mb-6">
              <span class="w-8 h-px bg-yellow/60"></span>
              Simuladores de formación
            </span>
            <h1 class="text-white text-4xl md:text-5xl xl:text-6xl font-bold leading-[1.08] text-balance mb-6">
              Nadie aprende a decidir <span class="text-yellow">leyendo</span> sobre decisiones
            </h1>
            <p class="text-white/75 text-lg md:text-xl leading-relaxed mb-9 max-w-xl mx-auto lg:mx-0">
              Construimos simuladores donde tu equipo practica el trabajo real: elige, se equivoca, ve la consecuencia y vuelve a intentar. En el navegador, sin instalar nada.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a href="#contact" class="inline-flex items-center justify-center whitespace-nowrap px-8 py-4 bg-accent text-white rounded-full font-semibold hover:bg-accent/90 transition-colors duration-200 shadow-xl shadow-accent/20">
                Agenda una demo guiada
              </a>
              <a href="#casos" class="inline-flex items-center justify-center gap-2 whitespace-nowrap px-8 py-4 border border-white/25 text-white rounded-full font-semibold hover:bg-white/10 transition-colors duration-200">
                Ver casos construidos
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
              </a>
            </div>
          </div>

          <div class="lg:col-span-7" data-revela data-revela-tarde>
            <figure class="relative">
              <div class="rounded-2xl overflow-hidden ring-1 ring-white/15 shadow-2xl shadow-black/50 bg-primary">
                <!-- barra de navegador: encuadra la captura como producto y no
                     como ilustración, y dice sin palabras "corre en el navegador" -->
                <div class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.06] border-b border-white/10">
                  <span class="w-2.5 h-2.5 rounded-full bg-white/25"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-white/25"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-white/25"></span>
                  <span class="ml-3 text-[11px] text-white/40 font-mono tracking-tight">simulador · comercio exterior</span>
                </div>
                <img
                  src="/assets/simuladores/comex.jpg"
                  alt="Simulador de comercio exterior: vista 3D del puerto con contenedores, el expediente documental abierto y el rol asignado al participante"
                  width="1280" height="820" loading="eager" decoding="async"
                  class="w-full h-auto"
                />
              </div>
              <figcaption class="mt-4 flex items-center justify-center lg:justify-start gap-2 text-sm text-white/50">
                <span class="relative flex w-2 h-2">
                  <span class="absolute inline-flex w-full h-full rounded-full bg-yellow opacity-60 motion-safe:animate-ping"></span>
                  <span class="relative inline-flex w-2 h-2 rounded-full bg-yellow"></span>
                </span>
                Captura del simulador funcionando hoy, no un montaje
              </figcaption>
            </figure>
          </div>

        </div>
      </div>
    </section>

    <!-- ══ El problema ══ -->
    <section class="py-24 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto" data-revela>
          <span class="block w-14 h-1 bg-accent rounded-full mb-8"></span>
          <h2 class="text-3xl md:text-5xl font-bold text-primary leading-tight text-balance mb-8">
            El curso se aprueba.<br class="hidden sm:block" /> La práctica no cambia.
          </h2>
          <p class="text-xl text-gray-600 leading-relaxed mb-5">
            Es el problema que nos traen todas las semanas. Los equipos completan la capacitación, responden bien la evaluación, y en el puesto siguen tomando las mismas decisiones de antes.
          </p>
          <p class="text-xl text-gray-600 leading-relaxed">
            No es falta de contenido. Es que leer sobre una decisión y tomarla son cosas distintas, y solo una de las dos se entrena.
          </p>
        </div>
      </div>
    </section>

    <!-- ══ Casos ══
         Cada caso ocupa el ancho y alterna el lado de la imagen. Antes eran dos
         tarjetas iguales encabezadas por un emoji; el argumento de la sección
         es "esto existe y funciona", y para eso hay que mostrarlo. -->
    <section id="casos" class="py-24 bg-gray-light">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-16">
          <span class="block w-14 h-1 bg-yellow rounded-full mb-8"></span>
          <h2 class="text-3xl md:text-5xl font-bold text-primary mb-5">Casos construidos</h2>
          <p class="text-xl text-gray-600">Simuladores que existen y funcionan hoy. Te los mostramos en vivo.</p>
        </div>

        <div class="space-y-16 lg:space-y-24">

          <article class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center" data-revela>
            <div class="rounded-2xl overflow-hidden ring-1 ring-primary/10 shadow-xl transition-transform duration-300 motion-safe:hover:-translate-y-1.5 motion-safe:hover:shadow-2xl">
              <img
                src="/assets/simuladores/comex.jpg"
                alt="Cuatro roles completan entre todos el expediente de una importación mientras recorren el puerto en 3D"
                width="1280" height="820" loading="lazy" decoding="async"
                class="w-full h-auto"
              />
            </div>
            <div>
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/10 text-secondary text-xs font-bold uppercase tracking-wider mb-5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Multijugador · roles interdependientes
              </span>
              <h3 class="text-2xl md:text-3xl font-bold text-primary mb-4">Operación de comercio exterior</h3>
              <p class="text-gray-600 mb-6 leading-relaxed">
                Una importación real desde el puerto hasta la liberación del contenedor. Cada participante toma un rol —importador, aduana, transportista, naviera— y ninguno puede avanzar solo: los documentos se completan entre varios y el contenedor se libera cuando la información calza.
              </p>
              <dl class="border-t border-primary/10 pt-6 space-y-2 text-sm text-gray-500">
                <div><dt class="inline font-bold text-primary">Qué se entrena: </dt><dd class="inline">Incoterms, clasificación arancelaria, consistencia documental, costeo y coordinación entre áreas.</dd></div>
                <div><dt class="inline font-bold text-primary">Para: </dt><dd class="inline">educación superior, exportadores, operadores logísticos y programas de formación técnica.</dd></div>
              </dl>
            </div>
          </article>

          <article class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center" data-revela>
            <div class="rounded-2xl overflow-hidden ring-1 ring-primary/10 shadow-xl lg:order-2 transition-transform duration-300 motion-safe:hover:-translate-y-1.5 motion-safe:hover:shadow-2xl">
              <img
                src="/assets/simuladores/planta.jpg"
                alt="Recorrido en 3D de una cámara de refrigeración: el participante camina hasta las estaciones críticas para resolver la tarea de cada puesto"
                width="1240" height="934" loading="lazy" decoding="async"
                class="w-full h-auto"
              />
            </div>
            <div class="lg:order-1">
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-yellow/15 text-yellow-700 text-xs font-bold uppercase tracking-wider mb-5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V8l5 3V8l5 3V8l4 2v11"/></svg>
                Espacial · procedimental
              </span>
              <h3 class="text-2xl md:text-3xl font-bold text-primary mb-4">Recorrido de planta</h3>
              <p class="text-gray-600 mb-6 leading-relaxed">
                El participante recorre una instalación real en 3D, entra a las estaciones críticas y resuelve la tarea de cada puesto. Cada estación abre con una mini-lección y cierra con una interacción, de modo que el conocimiento llega justo antes de usarlo.
              </p>
              <dl class="border-t border-primary/10 pt-6 space-y-2 text-sm text-gray-500">
                <div><dt class="inline font-bold text-primary">Qué se entrena: </dt><dd class="inline">procedimientos de puesto, secuencia correcta, puntos de control y reconocimiento del entorno.</dd></div>
                <div><dt class="inline font-bold text-primary">Para: </dt><dd class="inline">inducción de personal nuevo, plantas productivas y operaciones con protocolo.</dd></div>
              </dl>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- ══ Cómo es la experiencia ══
         Banda oscura a propósito: siete secciones claras seguidas hacían que la
         página se leyera toda igual. Acá el contraste marca el cambio de tema. -->
    <section class="py-24 bg-primary relative overflow-hidden">
      <div class="absolute inset-0 bg-[url('/assets/patronblancobajaopacidad.png')] bg-repeat opacity-[0.05]" aria-hidden="true"></div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-16">
          <span class="block w-14 h-1 bg-yellow rounded-full mb-8"></span>
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-5">Cómo es la experiencia</h2>
          <p class="text-xl text-white/70">Entre 5 y 15 minutos según el caso. Suficiente para que pase algo, corto para que nadie se pierda.</p>
        </div>
        <ol class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-white/10 rounded-2xl overflow-hidden">
          {pasos.map((p, i) => (
            <li class="bg-primary p-8 xl:p-9" data-revela style={`transition-delay:${i * 90}ms`}>
              <span class="block text-5xl font-bold text-white/15 leading-none mb-5 tabular-nums">{p.n}</span>
              <h3 class="text-lg font-bold text-yellow mb-3">{p.t}</h3>
              <p class="text-white/65 text-sm leading-relaxed">{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ══ Qué se puede simular ══ -->
    <section class="py-24 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-16">
          <span class="block w-14 h-1 bg-secondary rounded-full mb-8"></span>
          <h2 class="text-3xl md:text-5xl font-bold text-primary mb-5">Qué se puede simular</h2>
          <p class="text-xl text-gray-600">Si la tarea tiene decisiones, secuencia y consecuencias, se puede convertir en práctica.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="group p-8 rounded-2xl border border-gray-200 hover:border-secondary/40 hover:shadow-xl transition-all duration-200">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-secondary/10 text-secondary mb-6">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
            </span>
            <h3 class="text-xl font-bold text-primary mb-3">Operaciones</h3>
            <p class="text-gray-600 leading-relaxed">Procesos con variables, plazos y costos donde una decisión temprana condiciona el resto: logística, comercio exterior, producción, finanzas.</p>
          </div>
          <div class="group p-8 rounded-2xl border border-gray-200 hover:border-accent/40 hover:shadow-xl transition-all duration-200">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-accent/10 text-accent mb-6">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 9v4M12 16h.01"/></svg>
            </span>
            <h3 class="text-xl font-bold text-primary mb-3">Prevención de riesgos</h3>
            <p class="text-gray-600 leading-relaxed">Protocolos donde el orden importa y saltarse un paso tiene consecuencias: uso de EPP, bloqueo de energías, espacios confinados, respuesta ante incidentes.</p>
          </div>
          <div class="group p-8 rounded-2xl border border-gray-200 hover:border-yellow/50 hover:shadow-xl transition-all duration-200">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-yellow/15 text-yellow-700 mb-6">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg>
            </span>
            <h3 class="text-xl font-bold text-primary mb-3">Cumplimiento normativo</h3>
            <p class="text-gray-600 leading-relaxed">Procedimientos reglados con plazos legales exactos, donde equivocarse expone a la organización. Aquí las reglas son deterministas: la norma no se improvisa.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ Integración ══ -->
    <section class="py-24 bg-gray-light">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="max-w-3xl mb-14">
            <span class="block w-14 h-1 bg-accent rounded-full mb-8"></span>
            <h2 class="text-3xl md:text-5xl font-bold text-primary">Entra donde ya trabajan</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="flex gap-5">
              <span class="shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white text-secondary ring-1 ring-primary/10">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20z"/></svg>
              </span>
              <div>
                <h3 class="font-bold text-primary mb-1.5">Solo navegador</h3>
                <p class="text-gray-600 text-sm leading-relaxed">Sin instalación, sin lentes, sin hardware. Funciona en computador y se adapta a móvil.</p>
              </div>
            </div>
            <div class="flex gap-5">
              <span class="shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white text-accent ring-1 ring-primary/10">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
              </span>
              <div>
                <h3 class="font-bold text-primary mb-1.5">Se conecta a su LMS</h3>
                <p class="text-gray-600 text-sm leading-relaxed">Empaquetado estándar para que el resultado quede registrado donde ya llevan la formación.</p>
              </div>
            </div>
            <div class="flex gap-5">
              <span class="shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white text-yellow-700 ring-1 ring-primary/10">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6" rx="1"/><rect x="12" y="8" width="3" height="10" rx="1"/><rect x="17" y="5" width="3" height="13" rx="1"/></svg>
              </span>
              <div>
                <h3 class="font-bold text-primary mb-1.5">Evidencia, no completitud</h3>
                <p class="text-gray-600 text-sm leading-relaxed">Qué decidió cada persona, dónde se equivocó y si mejoró al reintentar. No solo si terminó.</p>
              </div>
            </div>
            <div class="flex gap-5">
              <span class="shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white text-primary ring-1 ring-primary/10">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/></svg>
              </span>
              <div>
                <h3 class="font-bold text-primary mb-1.5">Con su contenido</h3>
                <p class="text-gray-600 text-sm leading-relaxed">Partimos de sus procedimientos y sus casos reales. El escenario tiene que ser reconocible.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ Blueprint ══ -->
    <section class="py-24 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto rounded-3xl bg-primary relative overflow-hidden">
          <div class="absolute inset-0 bg-[url('/assets/patronblancobajaopacidad.png')] bg-repeat opacity-[0.06]" aria-hidden="true"></div>
          <div class="absolute -top-24 -right-16 w-80 h-80 rounded-full bg-yellow/15 blur-3xl" aria-hidden="true"></div>
          <div class="relative z-10 p-10 md:p-16 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-yellow mb-6 text-balance">El primer paso no es un proyecto</h2>
            <p class="text-white/80 text-lg leading-relaxed mb-9 max-w-3xl mx-auto">
              Antes de construir nada, trabajamos dos o tres semanas con su equipo para definir qué decisión vale la pena simular, cómo se evalúa y qué tendría que pasar para considerarlo un éxito. Se llama Blueprint y es un entregable en sí mismo: si al final decide no seguir, igual se queda con el diseño.
            </p>
            <a href="#contact" class="inline-flex items-center justify-center whitespace-nowrap px-8 py-4 bg-accent text-white rounded-full font-semibold hover:bg-accent/90 transition-colors duration-200 shadow-xl shadow-accent/20">
              Conversemos sobre su caso
            </a>
          </div>
        </div>
      </div>
    </section>

    <CTA />
    <Contact />
    <Footer />
  </main>

  <style>
    /* Entrada por scroll. El estado oculto se aplica SOLO si el script llegó a
       correr (la clase `js-revela` en <html>): si el JS falla o está bloqueado,
       el contenido se ve igual. Ocultar por CSS y revelar por JS es cómo se
       hacen las páginas que amanecen en blanco. */
    :global(html.js-revela) [data-revela] {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity .6s cubic-bezier(.22,.61,.36,1), transform .6s cubic-bezier(.22,.61,.36,1);
      will-change: opacity, transform;
    }
    :global(html.js-revela) [data-revela][data-revela-tarde] { transition-delay: .12s; }
    :global(html.js-revela) [data-revela].visible {
      opacity: 1;
      transform: none;
    }
    /* Quien pidió menos movimiento no recibe ninguno: el contenido aparece y
       ya. No es un extra de accesibilidad, es respetar una preferencia que la
       persona configuró a propósito. */
    @media (prefers-reduced-motion: reduce) {
      :global(html.js-revela) [data-revela] {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const raiz = document.documentElement;
      if (!("IntersectionObserver" in window)) return;
      raiz.classList.add("js-revela");
      const mostrar = (el) => el.classList.add("visible");
      const observador = new IntersectionObserver((entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          mostrar(e.target);
          observador.unobserve(e.target);   // entra una vez y se queda
        }
      }, { rootMargin: "0px 0px -12% 0px", threshold: 0.08 });

      const arrancar = () => {
        for (const el of document.querySelectorAll("[data-revela]")) {
          // lo que ya está en pantalla al cargar no debe esperar al scroll
          const r = el.getBoundingClientRect();
          if (r.top < innerHeight * 0.92) mostrar(el);
          else observador.observe(el);
        }
      };
      if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", arrancar);
      else arrancar();
    })();
  </script>
</BaseLayout>
