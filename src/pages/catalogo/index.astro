  .visor__fuera:hover { color: var(--tiza); border-color: rgba(255, 255, 255, 0.36); }
  .visor__fuera svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
  .visor__cerrar {
