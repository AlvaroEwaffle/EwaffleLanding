---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogLeadModal from '../../components/catalog/CatalogLeadModal.astro';

/* ═══════════════════════════════════════════════════════════════════════════
   CATÁLOGO · sala de proyección
   ───────────────────────────────────────────────────────────────────────────
   La versión anterior era un documento: portada, siete secciones numeradas,
   dos tablas y una lista de enlaces que se abrían todos en otra pestaña. El
   problema no era que estuviera fea — era que Ewaffle vende experiencias que
   se recorren y su catálogo pedía que le creyeran de palabra. Cada prueba de
   que el producto existe estaba a un clic de distancia... hacia afuera.

   Acá el catálogo ES la demostración. Tres cambios cargan el peso:

   1. DIRIGIDO. La página pregunta qué viniste a resolver antes de mostrar
      nada. Esas cuatro preguntas ya estaban en el documento, pero al final y
      en modo retórico ("preguntas para aterrizar este catálogo"). Puestas al
      principio y como decisión real, ordenan todo lo que viene después.
   2. ADENTRO. Casi todas las pruebas se abren y funcionan en esta misma
      página, en un visor. Las que no lo dicen en su propio botón: Articulate
      manda `x-frame-options: sameorigin` y no se deja incrustar por nadie.
   3. RECORRIDO. Escenas numeradas, un riel que marca dónde vas y cuántos
      formatos abriste, y un cotizador que cierra con un número. La
      gamificación termina en algo útil, no en un puntaje.

   Lo que NO hace: bloquear el contenido detrás del cuestionario. Desde la
   apertura hay una salida directa al catálogo completo — quien vino apurado
   a ver la lista tiene que poder verla.
   ═══════════════════════════════════════════════════════════════════════════ */

const title = "Catálogo de productos Ewaffle | E-learning, multimedia y simuladores";
const description = "Los siete formatos de aprendizaje digital de Ewaffle: videos formativos, guías interactivas, cápsulas interactivas, simuladores, recorridos 360, actividades lúdicas y producción en terreno. Cada uno con ejemplos reales que puedes probar acá mismo, y un cotizador para armar tu programa.";
const socialImage = "/assets/catalogo-og.png";

/* Las cuatro entradas del recorrido. Son las preguntas del catálogo viejo,
   convertidas en decisión. El texto de abajo es el síntoma con el que llega
   el cliente, no la categoría con la que lo clasificamos nosotros. */
const objetivos = [
  { id: "explicar",  n: "01", t: "Explicar mejor un tema",    d: "El contenido existe, pero no se entiende — o se entiende y se olvida a la semana." },
  { id: "practicar", n: "02", t: "Que practiquen de verdad",  d: "Aprueban la evaluación y en el puesto siguen decidiendo igual que antes." },
  { id: "ordenar",   n: "03", t: "Ordenar lo que ya existe",  d: "Hay material, pero vive en PDF, PPT y carpetas compartidas que nadie abre." },
  { id: "terreno",   n: "04", t: "Mostrar el lugar real",     d: "Necesitan reconocer la planta, la sala o el equipo antes de pisarlo." },
];

/* Una mezcla por objetivo. El catálogo viejo tenía tres combinaciones sueltas
   al final; acá cada una queda amarrada a la entrada que la justifica, que es
   lo que hace que la recomendación se sienta dirigida y no un menú más.
   Los nombres de las piezas son los mismos siete formatos de la escena 03: si
   la recomendación inventa vocabulario propio, el catálogo deja de leerse como
   un catálogo. */
const mezclas = {
  explicar: {
    tag: "Mix claridad",
    t: "Primero que se entienda. Después que se recuerde.",
    d: "Cuando el problema es de comprensión, agregar interactividad no arregla nada: hay que bajar la carga y darle una forma visual al concepto antes de pedir que lo apliquen.",
    piezas: [
      { t: "Video formativo", d: "Instala la idea en dos minutos, con el énfasis puesto donde importa." },
      { t: "Guía interactiva", d: "El desarrollo ordenado y navegable, para leer y volver a consultar." },
      { t: "Chequeo corto", d: "Preguntas de comprensión con feedback inmediato, sin nota." },
    ],
  },
  practicar: {
    tag: "Mix aprendizaje activo",
    t: "Nadie aprende a decidir leyendo sobre decisiones.",
    d: "Es la mezcla que más recomendamos. El video da el contexto, la actividad obliga a comprometerse con una respuesta, y la cápsula ramificada cubre lo que no tiene respuesta única.",
    piezas: [
      { t: "Video formativo", d: "Corto. Solo lo necesario para que la práctica tenga sentido." },
      { t: "Actividades lúdicas", d: "Donde la persona elige, se equivoca y recibe el porqué." },
      { t: "Cápsula interactiva", d: "Para los dilemas del puesto donde ninguna opción es gratis." },
    ],
  },
  ordenar: {
    tag: "Mix biblioteca",
    t: "El material ya está. Falta que alguien lo abra.",
    d: "Acá el trabajo es de arquitectura, no de producción: convertir lo disperso en algo que se recorra, se busque y quede disponible dentro del LMS o la intranet.",
    piezas: [
      { t: "Guía interactiva", d: "Reemplaza el manual PDF por algo que se recorre en el navegador." },
      { t: "Video formativo", d: "Una pieza de apertura por tema, para dar entrada a lo que ya existe." },
      { t: "Entrega SCORM", d: "Empaquetado para tu LMS, con registro de avance." },
    ],
  },
  terreno: {
    tag: "Mix onboarding en terreno",
    t: "Que reconozcan el lugar antes de llegar al lugar.",
    d: "Cuando el espacio físico es parte del aprendizaje, describirlo no alcanza. Se graba, se recorre y se practica la ubicación antes del primer turno.",
    piezas: [
      { t: "Producción en terreno", d: "Grabación presencial de espacios, equipos y procedimientos reales." },
      { t: "Recorrido 360", d: "La instalación completa, con la información puesta donde ocurre." },
      { t: "Actividades lúdicas", d: "Ubicación en plano: tienen que situar cada zona y su riesgo." },
    ],
  },
};

/* ── Los siete formatos ───────────────────────────────────────────────────
   Antes eran once tarjetas de 330 px en una grilla, y la grilla las igualaba:
   el simulador multijugador y un enlace a Articulate ocupaban el mismo
   rectángulo. Ahora cada formato es una banda de ancho completo que se lee de
   arriba a abajo, con la pantalla del recurso al lado del texto que lo explica.
   Once entraron en siete sin perder ninguno: los módulos Rise viven dentro de
   las guías, el motion dentro de video, y el árbol de decisiones dentro de las
   cápsulas, que es donde el cliente lo busca.

   `piezas[].modo` decide cómo se abre cada prueba:
     iframe  → demo propia, misma página, corre de verdad
     video   → mp4 en tefi.villelab.com; nunca autoplay (el de inducción pesa
               134 MB, y arrancarlo solo sería quemarle los datos a alguien)
     youtube → incrustado sin cookies
     externo → no se deja incrustar; se dice y se abre en otra pestaña
   `para` amarra el formato a los objetivos donde de verdad sirve. Si estuviera
   en los cuatro no serviría para dirigir nada. */
const formatos = [
  {
    id: "video", n: "01", grupo: "Audiovisual",
    titulo: "Videos formativos",
    resumen: "La pieza que abre el módulo y la que se reenvía cuando cambia un procedimiento.",
    img: "/assets/catalogo/video-induccion.webp",
    alt: "Fotograma del módulo de inducción de Buffalo Waffles: título sobre una escena de local con clientes",
    para: ["explicar", "ordenar"],
    texto: "Bajo un mismo nombre producimos tres cosas distintas: el video a cámara grabado con tu gente, el animado en motion graphics para las ideas que en texto ocupan tres carillas, y el video de módulo con locución y ritmo controlados. Cuál conviene lo decide el contenido, no el catálogo.",
    bullets: [
      "Locución en español neutro o chileno, con el énfasis puesto donde importa.",
      "Subtitulado, corte largo para el LMS y versión vertical para difusión interna.",
      "Cuando cambia el procedimiento se rehace el tramo, no el video completo.",
    ],
    piezas: [
      { t: "Módulo de inducción", modo: "video", src: "https://tefi.villelab.com/buffalo-m1-v8.3-HD.mp4", poster: "/assets/catalogo/video-induccion.webp", nota: "Buffalo Waffles · inducción a la operación" },
      { t: "Cápsula normativa", modo: "video", src: "https://tefi.villelab.com/achs-pnce-HD.mp4", poster: "/assets/catalogo/video-normativa.webp", nota: "Política Nacional de Convivencia Educativa" },
      { t: "Pieza animada", modo: "youtube", src: "rf5-fAPg9wU", nota: "Motion graphics · video caso para actividad" },
    ],
  },
  {
    id: "guias", n: "02", grupo: "Contenido",
    titulo: "Guías interactivas",
    resumen: "El manual que nadie abre, convertido en algo que se recorre y se termina.",
    img: "/assets/catalogo/guias.webp",
    alt: "Guía interactiva abierta en el navegador: índice de lecciones a la izquierda, barra de avance y contenido de la lección",
    para: ["ordenar", "explicar"],
    texto: "Se abre en el navegador, sin instalar nada y sin crear cuenta, así que un trabajador nuevo puede hacer su inducción el primer día sin esperar a que TI le habilite un acceso. Es también el formato del contenido que se consulta más de una vez —normativa, procedimientos, fundamentos— y que hoy vive disperso en PDF y carpetas compartidas.",
    bullets: [
      "Para inducción, procedimientos y onboarding de contratistas.",
      "Índice, barra de avance y memoria de dónde quedó. Igual en celular, tablet y escritorio.",
      "Se entrega como SCORM para tu LMS o como enlace directo, según dónde viva.",
    ],
    piezas: [
      { t: "Recorrer la guía completa", modo: "iframe", src: "/demos/buffalo-induccion.html", nota: "Tres lecciones con video, avance y cierre" },
      { t: "La versión con actividades", modo: "iframe", src: "/demos/buffalo-induccion-juegos.html", nota: "La misma guía, con actividades intercaladas" },
      { t: "Ejemplo en Articulate Rise", modo: "externo", src: "https://360.articulate.com/review/content/d0260191-6bb2-4656-9524-5bc9c615cb9f/review", nota: "Articulate Review · no se deja incrustar" },
    ],
  },
  {
    id: "capsulas", n: "03", grupo: "Criterio",
    titulo: "Cápsulas interactivas",
    resumen: "Escenarios ramificados para los temas donde ninguna opción es gratis.",
    img: "/assets/catalogo/arbol.webp",
    alt: "Curso Decidir más cerca de Caja Los Héroes: índice de 24 lecciones y el video de la primera",
    para: ["practicar"],
    texto: "Para buen trato, ética, prevención o autonomía, donde el objetivo no es que recuerden la norma sino que sostengan un criterio cuando nadie los está mirando. La persona elige, ve la consecuencia y recibe el porqué — que es la parte que después se repite en el pasillo.",
    bullets: [
      "Trabaja los dilemas reales del puesto, levantados con tu gente, no casos de manual.",
      "Sin respuestas obvias: cada camino tiene un costo defendible.",
      "Estándar Articulate Storyline, con la retroalimentación dentro del propio recurso.",
    ],
    piezas: [
      { t: "Recorrer un caso completo", modo: "iframe", src: "/demos/los-heroes-decidir-mas-cerca.html", nota: "Caja Los Héroes · 24 lecciones" },
      { t: "Árbol de decisiones", modo: "iframe", src: "/demo-scorm/arbol-decision/story.html", nota: "ACHS DS44 · escenario ramificado en Storyline" },
      { t: "Otro ejemplo Storyline", modo: "externo", src: "https://360.articulate.com/review/content/5b3fb8d6-cecd-4f2c-84af-bf83b785ebfc/review", nota: "Articulate Review · no se deja incrustar" },
    ],
  },
  {
    id: "simuladores", n: "04", grupo: "Simulación",
    titulo: "Simuladores",
    resumen: "Practican la operación completa antes de tocar una real.",
    img: "/assets/catalogo/comex.webp",
    alt: "Puerto con grúas y portacontenedores al atardecer, con los cuatro roles del simulador listados abajo",
    para: ["practicar"],
    texto: "En el simulador de comercio exterior cada participante entra con un rol distinto —naviera, aduana, transportista, importador— y si los papeles no cuadran, el contenedor no se mueve. El error sale gratis acá y caro en el puerto. También replicamos sistemas internos, para que nadie aprenda tu plataforma equivocándose sobre datos de producción.",
    bullets: [
      "Trabajan sobre documentación real: B/L, factura comercial y DIN.",
      "La respuesta está en el expediente, así que entrenan criterio y no memoria.",
      "Multijugador: lo que se entrena es la coordinación entre roles, no una tarea suelta.",
      "Desarrollo propio de Ewaffle: no pagas licencia de plataforma por usuario.",
    ],
    piezas: [
      { t: "Ver cómo funciona", modo: "video", src: "https://tefi.villelab.com/comex-live-explainer.mp4", poster: "/assets/catalogo/comex.webp", nota: "Recorrido narrado del simulador de comercio exterior" },
      { t: "Simulador de plataforma", modo: "iframe", src: "/demos/lms-sim.html", nota: "SCORM 1.2 con la consola de llamadas a la vista" },
    ],
  },
  {
    id: "tour360", n: "05", grupo: "Inmersivo",
    titulo: "Recorridos 360",
    resumen: "Que reconozcan la planta antes del primer turno.",
    img: "/assets/catalogo/tour360.webp",
    alt: "Portada de un recorrido virtual 360 de un centro de simulación, con el botón de inicio sobre la fachada",
    para: ["terreno"],
    texto: "La información aparece justo donde está el riesgo, en vez de en un anexo que se lee lejos del lugar. La inducción presencial se acorta porque la gente llega ubicada, y el contratista que viene por dos días puede recorrer la instalación antes de entrar.",
    bullets: [
      "Para inducciones de planta, prevención de riesgos y visitas de contratistas.",
      "Se navega desde el navegador o con visor; no hay que instalar una aplicación.",
      "Se combina con producción en terreno cuando el espacio hay que grabarlo de cero.",
    ],
    piezas: [
      { t: "Recorrido interactivo", modo: "iframe", src: "https://storage.net-fs.com/hosting/2727323/380/index.htm", nota: "Tour de muestra de 3DVista — la tecnología, no un proyecto nuestro" },
      { t: "Recorrido en video", modo: "youtube", src: "7iaJIuOoxzE", nota: "Planta Arauco · Logmeter" },
      { t: "Nuestro servicio 360", modo: "externo", src: "https://ewaffle.cl/servicio-360/", nota: "Página del servicio" },
    ],
  },
  {
    id: "ludicas", n: "06", grupo: "Práctica",
    titulo: "Actividades lúdicas",
    resumen: "Ocho mecánicas ya construidas y probadas, listas para cargar tu contenido.",
    img: "/assets/catalogo/juegos.webp",
    alt: "Actividad de sopa de letras dentro de un curso, con las pistas al costado y el contador de aciertos",
    para: ["practicar", "terreno"],
    texto: "Sube cuánta gente termina el curso sin tener que alargarlo: en vez de leer el contenido, lo practican. Como las mecánicas ya están construidas, tu presupuesto se va en adaptar tu contenido y no en desarrollar desde cero.",
    bullets: [
      "Ruleta, memorice, millonario, sopa de letras, rueda de conceptos, arrastrar y soltar y ubicación en plano — más el árbol de decisiones, que por su peso tiene su propio formato acá arriba.",
      "Se arman con los conceptos reales de tu programa, no con ejemplos genéricos.",
      "Sin nota al LMS y con reintentos ilimitados: se practica sin miedo a reprobar.",
    ],
    piezas: [
      { t: "Jugar la demo", modo: "iframe", src: "/demos/juegos-demo.html", nota: "Cuatro mecánicas encadenadas como un curso real" },
      { t: "Ver las ocho mecánicas", modo: "iframe", src: "/demos/juegos-referencia.html", nota: "Referencia de cuándo conviene cada una" },
      { t: "Ubicación en plano", modo: "iframe", src: "/demos/hotspot-plano-prototipo.html", nota: "Ocho zonas de un local, por función" },
    ],
  },
  {
    id: "terreno", n: "07", grupo: "En terreno",
    titulo: "Producción en terreno",
    resumen: "Tus espacios, tus equipos y tu gente, grabados donde ocurre el trabajo.",
    img: "/assets/catalogo/terreno.webp",
    alt: "Grabación en estudio: una persona hablando a cámara con iluminación de set",
    para: ["terreno", "explicar"],
    texto: "Cuando la credibilidad depende de que se vea tu operación de verdad. Un caso genérico no le habla a alguien que trabaja ahí todos los días, y se nota en la primera pantalla: el video con el uniforme y la máquina correctos se mira distinto que el de archivo.",
    bullets: [
      "Para demostraciones de procedimiento, testimonios y recorridos de planta.",
      "Grabamos en tu instalación con el equipo operando, y en set cuando conviene.",
      "Se cotiza por jornada, y una jornada bien planificada alimenta varios módulos.",
    ],
    piezas: [
      { t: "Ver ejemplo en terreno", modo: "youtube", src: "OCu-5fmS_mI", nota: "Pieza a cámara, producción propia" },
      { t: "Otro ejemplo (Drive)", modo: "externo", src: "https://drive.google.com/file/d/1hKQp1twOOka8PY_hYZMCGAmktgcZ9p-b/view", nota: "Se abre en Google Drive" },
    ],
