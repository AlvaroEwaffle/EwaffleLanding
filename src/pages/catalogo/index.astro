<script type="application/json" id="catalogo-datos" is:inline set:html={JSON.stringify({ mezclas, objetivos: objetivos.map((o) => ({ id: o.id, t: o.t })), nombres: Object.fromEntries(formatos.map((r) => [r.id, r.titulo])), total: formatos.length, cotizador })}></script>

<script is:inline>
  /* ═══════════════════════════════════════════════════════════════════════
     El recorrido. Cuatro cosas y nada más: marcar dónde vas, recordar qué
     elegiste, abrir el visor y armar la hoja de rodaje del cierre.
     ═══════════════════════════════════════════════════════════════════════ */
  (function () {
    var datos = JSON.parse(document.getElementById("catalogo-datos").textContent);
    var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var LLAVE_OBJETIVO = "ewaffle:catalogo:objetivo";
    var LLAVE_VISTOS = "ewaffle:catalogo:vistos";

    function leer(k, porDefecto) {
      try { var v = sessionStorage.getItem(k); return v ? JSON.parse(v) : porDefecto; } catch (e) { return porDefecto; }
    }
    function guardar(k, v) { try { sessionStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }

    var objetivo = leer(LLAVE_OBJETIVO, null);
    var vistos = leer(LLAVE_VISTOS, []);

    function evento(nombre, extra) {
      var carga = Object.assign({ event: nombre }, extra || {});
      if (window.dataLayer) window.dataLayer.push(carga);
      if (window.ewaffleAnalytics && window.ewaffleAnalytics.capture) {
        window.ewaffleAnalytics.capture(nombre, extra || {});
      }
    }

    /* ── Entrada por scroll ─────────────────────────────────────────────── */
    var animables = Array.prototype.slice.call(document.querySelectorAll("[data-motion]"));
    if (quieto || !("IntersectionObserver" in window)) {
      animables.forEach(function (el) { el.classList.add("es-visible"); });
    } else {
      var ojo = new IntersectionObserver(function (entradas) {
        entradas.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add("es-visible");
          ojo.unobserve(e.target);
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
      animables.forEach(function (el) { ojo.observe(el); });
    }

    /* ── Riel: escena actual + avance ───────────────────────────────────── */
    var secciones = Array.prototype.slice.call(document.querySelectorAll(".escena[id]"));
    var itemsRiel = Array.prototype.slice.call(document.querySelectorAll("[data-riel]"));
    var barra = document.querySelector("[data-barra]");

    function pintarRiel() {
      var alto = document.documentElement.scrollHeight - window.innerHeight;
      var avance = alto <= 0 ? 0 : Math.min(window.scrollY / alto, 1);
      if (barra) barra.style.width = (avance * 100).toFixed(1) + "%";

      /* La escena "actual" es la última cuyo borde superior ya pasó el tercio
         alto de la pantalla. Usar la más visible daría saltos hacia atrás en
         las secciones cortas. */
      var actual = secciones[0];
      var corte = window.innerHeight * 0.34;
      secciones.forEach(function (s) {
        if (s.hasAttribute("hidden")) return;
        if (s.getBoundingClientRect().top <= corte) actual = s;
      });
      itemsRiel.forEach(function (a) {
        a.classList.toggle("es-actual", a.getAttribute("data-riel") === actual.id);
      });
    }
    pintarRiel();
    window.addEventListener("scroll", pintarRiel, { passive: true });
    window.addEventListener("resize", pintarRiel);
    /* Un salto por ancla no siempre dispara `scroll`, así que al entrar con
       `/catalogo/#cotizador` el riel se quedaba marcando la escena anterior. */
    window.addEventListener("hashchange", function () { setTimeout(pintarRiel, 60); });
    setTimeout(pintarRiel, 120);

    /* Si todavía no hay objetivo, el enlace a "Tu mezcla" no puede llevar a una
       sección oculta: lleva a la pregunta que la desbloquea. */
    itemsRiel.forEach(function (a) {
      a.addEventListener("click", function (ev) {
        if (a.getAttribute("data-riel") === "mezcla" && !objetivo) {
          ev.preventDefault();
          irA(document.getElementById("brief"));
        }
      });
    });

    function irA(el) {
      if (!el) return;
      var antes = window.scrollY;
      var destino = el.getBoundingClientRect().top + window.scrollY;
      if (quieto) { window.scrollTo(0, destino); return; }
      el.scrollIntoView({ behavior: "smooth", block: "start" });
      /* Hay entornos donde `behavior:"smooth"` queda inerte —pestaña sin foco,
         ajustes del sistema, alguna extensión— y el salto simplemente no ocurre.
         Si a los 500 ms no nos movimos, se salta sin animación: un enlace que no
         lleva a ninguna parte es mucho peor que uno sin transición. */
      setTimeout(function () {
        if (Math.abs(window.scrollY - antes) < 4) window.scrollTo(0, destino);
      }, 500);
    }

    /* ── Escena 01 → 02: la elección ────────────────────────────────────── */
    var seccionMezcla = document.getElementById("mezcla");
    var botonesObjetivo = Array.prototype.slice.call(document.querySelectorAll("[data-objetivo]"));
    var reels = Array.prototype.slice.call(document.querySelectorAll("[data-reel]"));
    var filtro = document.querySelector("[data-filtro]");
    var filtroTexto = document.querySelector("[data-filtro-texto]");

    function nombreObjetivo(id) {
      var o = datos.objetivos.filter(function (x) { return x.id === id; })[0];
      return o ? o.t : null;
    }

    function aplicarObjetivo(id, moverse) {
      objetivo = id;
      guardar(LLAVE_OBJETIVO, id);

      botonesObjetivo.forEach(function (b) {
        b.classList.toggle("es-elegida", b.getAttribute("data-objetivo") === id);
        b.setAttribute("aria-pressed", b.getAttribute("data-objetivo") === id ? "true" : "false");
      });

      var m = datos.mezclas[id];
      if (m) {
        seccionMezcla.removeAttribute("hidden");
        document.querySelector("[data-mezcla-tag]").textContent = "· " + m.tag;
        document.querySelector("[data-mezcla-titulo]").textContent = m.t;
        document.querySelector("[data-mezcla-texto]").textContent = m.d;
        m.piezas.forEach(function (p, i) {
          var li = document.querySelector('[data-mezcla-pieza="' + i + '"]');
          if (!li) return;
          li.querySelector("b").textContent = p.t;
          li.querySelector("span:last-child").textContent = p.d;
          li.style.setProperty("--retardo", i * 110 + "ms");
          li.classList.remove("es-visible");
          /* Doble rAF: sacar y volver a poner la clase en el mismo cuadro no
             reinicia la transición, el navegador no ve dos estados. */
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { li.classList.add("es-visible"); });
          });
        });
      }

      /* El catálogo NO se filtra: se ordena la atención. Los que sirven para el
         objetivo se marcan; el resto baja de intensidad pero sigue ahí y vuelve
         a intensidad plena al pasarle el mouse. Esconderlos sería decidir por la
         persona qué puede ver. */
      reels.forEach(function (r) {
        var sirve = (r.getAttribute("data-para") || "").split(" ").indexOf(id) !== -1;
        r.classList.toggle("es-recomendado", sirve);
        r.classList.toggle("es-apagado", !sirve);
      });
      if (filtro && filtroTexto) {
        filtroTexto.textContent = "Destacamos lo que mejor resuelve " + (nombreObjetivo(id) || "tu objetivo").toLowerCase() + ".";
        filtro.removeAttribute("hidden");
      }

      pintarRodaje();
      pintarRiel();
      if (moverse) irA(seccionMezcla);
      evento("catalogo_objetivo", { objetivo: id });
    }

    function limpiarObjetivo() {
      objetivo = null;
      guardar(LLAVE_OBJETIVO, null);
      botonesObjetivo.forEach(function (b) { b.classList.remove("es-elegida"); b.setAttribute("aria-pressed", "false"); });
      reels.forEach(function (r) { r.classList.remove("es-recomendado", "es-apagado"); });
      if (filtro) filtro.setAttribute("hidden", "");
      seccionMezcla.setAttribute("hidden", "");
      pintarRodaje();
      pintarRiel();
    }

    botonesObjetivo.forEach(function (b) {
      b.setAttribute("aria-pressed", "false");
      b.addEventListener("click", function () { aplicarObjetivo(b.getAttribute("data-objetivo"), true); });
    });

    var recalcular = document.querySelector("[data-recalcular]");
    if (recalcular) recalcular.addEventListener("click", function () { irA(document.getElementById("brief")); });

    var quitarFiltro = document.querySelector("[data-filtro-quitar]");
    if (quitarFiltro) quitarFiltro.addEventListener("click", function () { limpiarObjetivo(); });

    /* ── Vistos ─────────────────────────────────────────────────────────── */
    var cuenta = document.querySelector("[data-vistos]");

    function pintarVistos() {
      if (cuenta) cuenta.textContent = String(vistos.length);
      reels.forEach(function (r) {
        var marca = r.querySelector("[data-visto-marca]");
        if (!marca) return;
        if (vistos.indexOf(r.getAttribute("data-reel")) !== -1) marca.removeAttribute("hidden");
        else marca.setAttribute("hidden", "");
      });
    }

    function marcarVisto(id) {
      if (!id || vistos.indexOf(id) !== -1) return;
      vistos.push(id);
      guardar(LLAVE_VISTOS, vistos);
      pintarVistos();
      pintarRodaje();
    }

    /* ── Hoja de rodaje ─────────────────────────────────────────────────── */
    var celdaObjetivo = document.querySelector("[data-rodaje-objetivo]");
    var celdaMezcla = document.querySelector("[data-rodaje-mezcla]");
    var celdaVistos = document.querySelector("[data-rodaje-vistos]");

    function pintarRodaje() {
      var nombre = objetivo ? nombreObjetivo(objetivo) : null;
      if (celdaObjetivo) {
        celdaObjetivo.textContent = nombre || "Sin elegir todavía";
        celdaObjetivo.classList.toggle("es-lleno", !!nombre);
      }
      if (celdaMezcla) {
        var m = objetivo ? datos.mezclas[objetivo] : null;
        celdaMezcla.textContent = m ? m.tag + " — " + m.piezas.map(function (p) { return p.t; }).join(" + ") : "—";
        celdaMezcla.classList.toggle("es-lleno", !!m);
      }
      if (celdaVistos) {
        celdaVistos.textContent = vistos.length === 0
          ? "Ninguno todavía"
          : vistos.length + " de " + datos.total;
        celdaVistos.classList.toggle("es-lleno", vistos.length > 0);
      }
    }

    /* ── El visor ───────────────────────────────────────────────────────── */
    var visor = document.getElementById("visor");
    var pantalla = visor.querySelector("[data-visor-pantalla]");
    var tituloVisor = document.getElementById("visor-titulo");
    var notaVisor = visor.querySelector("[data-visor-nota]");
    var pieVisor = visor.querySelector("[data-visor-pie]");
    var salidaVisor = visor.querySelector("[data-visor-fuera]");
    var focoPrevio = null;

    var PIES = {
      iframe: "Es el recurso real corriendo acá dentro, no una maqueta.",
      video: "Video completo. Empieza cuando le des play — no se descarga solo.",
      youtube: "Alojado en YouTube, incrustado sin cookies de seguimiento."
    };

    function abrirVisor(boton) {
      var modo = boton.getAttribute("data-modo");
      var src = boton.getAttribute("data-src");
      var poster = boton.getAttribute("data-poster");
      var nota = boton.getAttribute("data-nota");
      var pieza = boton.getAttribute("data-pieza-nombre");
      var reel = boton.getAttribute("data-abrir");

      focoPrevio = document.activeElement;
      tituloVisor.textContent = boton.getAttribute("data-reel-titulo") + " · " + pieza;
      notaVisor.textContent = nota || "";
      pieVisor.textContent = PIES[modo] || "";

      var urlFuera = modo === "youtube" ? "https://www.youtube.com/watch?v=" + src : src;
      salidaVisor.setAttribute("href", urlFuera);

      pantalla.innerHTML = "";
      if (modo === "video") {
        var v = document.createElement("video");
        v.setAttribute("controls", "");
        v.setAttribute("playsinline", "");
        v.setAttribute("preload", "none");
        /* `preload="none"` no es un detalle: el módulo de inducción pesa 134 MB
           y el de la política, 73 MB. Precargarlos le costaría los datos a
           cualquiera que abra la página desde el celular sin pedir nada. */
        if (poster) v.setAttribute("poster", poster);
        v.src = src;
        pantalla.appendChild(v);
      } else {
        var f = document.createElement("iframe");
        f.setAttribute("title", tituloVisor.textContent);
        f.setAttribute("loading", "lazy");
        f.setAttribute("allow", "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen; xr-spatial-tracking");
        f.setAttribute("allowfullscreen", "");
        f.src = modo === "youtube"
          ? "https://www.youtube-nocookie.com/embed/" + src + "?rel=0&modestbranding=1"
          : src;
        pantalla.appendChild(f);
      }

      visor.removeAttribute("hidden");
      document.body.style.overflow = "hidden";
      visor.querySelector(".visor__cerrar").focus();
      marcarVisto(reel);
      evento("catalogo_visor_abre", { recurso: reel, pieza: pieza, modo: modo });
    }

    function cerrarVisor() {
      if (visor.hasAttribute("hidden")) return;
      visor.setAttribute("hidden", "");
      /* Vaciar la pantalla es lo que detiene el video o el iframe. Solo ocultar
         el visor lo dejaría sonando detrás. */
      pantalla.innerHTML = "";
      document.body.style.overflow = "";
      if (focoPrevio && focoPrevio.focus) focoPrevio.focus();
    }

    document.querySelectorAll("[data-abrir]").forEach(function (b) {
      b.addEventListener("click", function () { abrirVisor(b); });
    });
    visor.querySelectorAll("[data-visor-cerrar]").forEach(function (b) {
      b.addEventListener("click", cerrarVisor);
    });

    /* Las piezas que se abren fuera también cuentan como vistas: la persona hizo
       el gesto de mirarla, aunque el destino no se deje incrustar. */
    document.querySelectorAll("[data-marca]").forEach(function (a) {
      a.addEventListener("click", function () {
        marcarVisto(a.getAttribute("data-marca"));
        evento("catalogo_visor_abre", { recurso: a.getAttribute("data-marca"), pieza: a.getAttribute("data-pieza-nombre"), modo: "externo" });
      });
    });

    document.addEventListener("keydown", function (e) {
      if (visor.hasAttribute("hidden")) return;
      if (e.key === "Escape") { cerrarVisor(); return; }
      if (e.key !== "Tab") return;

      /* Trampa de foco. Sin esto el tabulador se va a la página de atrás, que
         está tapada: se navega a ciegas. */
      var focos = visor.querySelectorAll("a[href], button:not([disabled]), iframe, video, [tabindex]:not([tabindex='-1'])");
      if (!focos.length) return;
      var primero = focos[0];
      var ultimo = focos[focos.length - 1];
      if (e.shiftKey && document.activeElement === primero) { e.preventDefault(); ultimo.focus(); }
      else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primero.focus(); }
    });

    /* ── Cierre: el formulario llega con lo que ya nos dijo ─────────────── */
    var botonForm = document.querySelector("[data-abrir-form]");
    if (botonForm) {
      botonForm.addEventListener("click", function () {
        evento("catalogo_cta", { destino: "formulario", objetivo: objetivo || "sin_elegir", vistos: vistos.length });
        if (typeof window.ewaffleAbrirModalCatalogo === "function") {
          /* Con la cotización incluida: si la persona bajó hasta acá ya pasó por
             el cotizador, y llegar al formulario sin ese número obligaría al
             equipo a preguntarlo de nuevo. */
          window.ewaffleAbrirModalCatalogo(contexto(true));
        } else {
          window.location.href = "https://ewaffle.cl/#contact";
        }
      });
    }

    document.querySelectorAll("[data-cta]").forEach(function (a) {
      a.addEventListener("click", function () { evento("catalogo_cta", { destino: a.getAttribute("data-cta") }); });
    });

    /* ── Escena 04: el cotizador ────────────────────────────────────────
       Reemplaza a las pestañas de anatomía. Todo el cálculo vive acá y en el
       bloque `cotizador` del frontmatter, que sale del price book.

       Regla de la interfaz: se muestra QUÉ elegiste y CUÁNTO suma. Nunca
       cuánto vale cada línea. */
    var cot = datos.cotizador;
    var elCantidad = document.querySelector("[data-cantidad]");
    var elTotal = document.querySelector("[data-total]");
    var elRango = document.querySelector("[data-rango]");
    var elLineas = document.querySelector("[data-resumen-lineas]");
    var elVolumen = document.querySelector("[data-volumen]");

    function pesos(n) {
      /* Sin decimales y con punto de miles: un total con centavos en un
         cotizador referencial promete una exactitud que no existe. */
      return "$" + Math.round(n).toLocaleString("es-CL");
    }
    function aDiez(n) { return Math.round(n / 10000) * 10000; }

    function pctVolumen(q) {
      for (var i = 0; i < cot.volumen.length; i++) {
        if (q >= cot.volumen[i].desde && q <= cot.volumen[i].hasta) return cot.volumen[i].pct;
      }
      return 0;
    }

    function calcular() {
      if (!elTotal || !elCantidad) return null;

      var q = parseInt(elCantidad.value, 10);
      if (!q || q < 1) q = 1;
      if (q > 30) q = 30;

      var marcada = document.querySelector("[data-base]:checked");
      var baseId = marcada ? marcada.value : null;
      var base = cot.bases[0];
      cot.bases.forEach(function (b) { if (b.id === baseId) base = b; });

      var elegidos = [];
      Array.prototype.slice.call(document.querySelectorAll("[data-extra]:checked"))
        .forEach(function (c) { elegidos.push(c.value); });

      var pct = pctVolumen(q);
      var suma = base.price * q * (1 - pct / 100);
      var lineas = [{ t: base.t, n: q, u: q === 1 ? "módulo" : "módulos" }];

      cot.extras.forEach(function (e) {
        if (elegidos.indexOf(e.id) === -1) return;
        var veces = e.por === "modulo" ? q : 1;
        suma += e.price * veces;
        lineas.push({ t: e.t, n: veces, u: e.por === "modulo" ? (veces === 1 ? "módulo" : "módulos") : "" });
      });

      return { q: q, base: base, pct: pct, total: aDiez(suma), lineas: lineas, extras: elegidos };
    }

    function pintarCotizador() {
      var r = calcular();
      if (!r) return;

      if (elLineas) {
        elLineas.innerHTML = "";
        r.lineas.forEach(function (l) {
          var li = document.createElement("li");
          var b = document.createElement("span");
          b.textContent = l.t;
          li.appendChild(b);
          if (l.n > 1 || l.u) {
            var em = document.createElement("em");
            em.textContent = l.u ? "× " + l.n + " " + l.u : "× " + l.n;
            li.appendChild(em);
          }
          elLineas.appendChild(li);
        });
      }

      if (elTotal) elTotal.textContent = pesos(r.total);
      if (elRango) {
        elRango.textContent = "Rango de referencia " + pesos(aDiez(r.total * cot.rango.bajo)) +
          " – " + pesos(aDiez(r.total * cot.rango.alto));
      }
      if (elVolumen) {
        elVolumen.innerHTML = "";
        var nota = document.createElement("span");
        if (r.pct > 0) {
          nota.innerHTML = "Incluye <b>" + r.pct + "% de descuento</b> por volumen sobre los módulos.";
        } else {
          nota.textContent = "Desde dos módulos se aplica descuento por volumen.";
        }
        elVolumen.appendChild(nota);
      }
      return r;
    }

    if (elCantidad) {
      /* `change` no basta: escribiendo el número a mano el total se quedaría
         quieto hasta perder el foco, y el cotizador dejaría de responder justo
         cuando la persona está probando cifras. */
      elCantidad.addEventListener("input", pintarCotizador);
      elCantidad.addEventListener("change", function () {
        var q = parseInt(elCantidad.value, 10);
        if (!q || q < 1) elCantidad.value = 1;
        if (q > 30) elCantidad.value = 30;
        pintarCotizador();
      });
    }
    function mover(paso) {
      if (!elCantidad) return;
      var q = (parseInt(elCantidad.value, 10) || 1) + paso;
      elCantidad.value = Math.max(1, Math.min(30, q));
      pintarCotizador();
      evento("catalogo_cotizador", { campo: "cantidad", valor: elCantidad.value });
    }
    var bMenos = document.querySelector("[data-menos]");
    var bMas = document.querySelector("[data-mas]");
    if (bMenos) bMenos.addEventListener("click", function () { mover(-1); });
    if (bMas) bMas.addEventListener("click", function () { mover(1); });

    document.querySelectorAll("[data-base]").forEach(function (c) {
      c.addEventListener("change", function () {
        pintarCotizador();
        evento("catalogo_cotizador", { campo: "base", valor: c.value });
      });
    });
    document.querySelectorAll("[data-extra]").forEach(function (c) {
      c.addEventListener("change", function () {
        pintarCotizador();
        evento("catalogo_cotizador", { campo: "extra", valor: c.value, activo: c.checked });
      });
    });

    /* El contexto que viaja al formulario: lo que eligió en el recorrido más lo
       que armó en el cotizador. Los nombres, no los identificadores — esto lo
       lee una persona del equipo en el correo del lead. */
    function contexto(conCotizacion) {
      var lineas = [];
      if (objetivo) {
        lineas.push("Lo que quiero resolver: " + nombreObjetivo(objetivo) + ".");
        var m = datos.mezclas[objetivo];
        if (m) lineas.push("Mezcla sugerida en el catálogo: " + m.tag + ".");
      }
      if (vistos.length) {
        lineas.push("Formatos que probé: " + vistos.map(function (id) {
          return datos.nombres[id] || id;
        }).join("; ") + ".");
      }
      if (conCotizacion) {
        var r = calcular();
        if (r) {
          lineas.push("");
          lineas.push("Armé esto en el cotizador:");
          r.lineas.forEach(function (l) {
            lineas.push("· " + l.t + (l.n > 1 || l.u ? " × " + l.n + (l.u ? " " + l.u : "") : ""));
          });
          lineas.push("Estimación que me mostró la página: " + pesos(r.total) + " (exento de IVA).");
        }
      }
      return lineas.join("\n");
    }

    var ctaCotiza = document.querySelector("[data-cotiza-cta]");
    if (ctaCotiza) {
      ctaCotiza.addEventListener("click", function () {
        var r = calcular();
        evento("catalogo_cta", {
          destino: "cotizacion",
          modulos: r ? r.q : null,
          base: r ? r.base.id : null,
          extras: r ? r.extras.join(",") : "",
          total: r ? r.total : null
        });
        if (typeof window.ewaffleAbrirModalCatalogo === "function") {
          window.ewaffleAbrirModalCatalogo(contexto(true));
        } else {
          window.location.href = "https://ewaffle.cl/#contact";
        }
      });
    }

    /* ── Estado inicial ─────────────────────────────────────────────────── */
    pintarVistos();
    pintarCotizador();
    if (objetivo && datos.mezclas[objetivo]) aplicarObjetivo(objetivo, false);
    else pintarRodaje();
  })();
</script>
