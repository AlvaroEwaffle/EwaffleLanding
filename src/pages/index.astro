---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import ServicesOverview from '../components/landing/ServicesOverview.astro';
import CatalogSpotlight from '../components/landing/CatalogSpotlight.astro';
import Benefits from '../components/landing/Benefits.astro';
import TechnologyShowcase from '../components/landing/TechnologyShowcase.astro';
import UseCases from '../components/landing/UseCases.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import AcademiaBanner from '../components/landing/AcademiaBanner.astro';
import SimuladoresBanner from '../components/landing/SimuladoresBanner.astro';
import MeetOurTeam from '../components/landing/MeetOurTeam.astro';
import Process from '../components/landing/Process.astro';
import Onboarding360Spotlight from '../components/landing/Onboarding360Spotlight.astro';
import FAQ from '../components/landing/FAQ.astro';
import Contact from '../components/landing/Contact.astro';
import CTA from '../components/landing/CTA.astro';
import Footer from '../components/landing/Footer.astro';

// SEO Metadata for main landing page
const title = "Ewaffle | Plataforma LMS, onboarding y cursos gamificados para empresas";
const description = "Plataformas LMS marca blanca, journeys de onboarding, cursos gamificados, recursos e-learning, chatbots IA y producción multimedia para grandes empresas e instituciones privadas.";
const canonicalUrl = "https://ewaffle.cl";
const imageUrl = "https://ewaffle.cl/assets/logoprimario.png";
const keywords = "plataforma LMS para empresas, LMS corporativo, onboarding corporativo, academia corporativa, cursos gamificados, cursos SCORM, recursos e-learning, integración LMS, marca blanca LMS, capacitación interna, instituciones privadas, grandes empresas, e-learning Chile, e-learning Latinoamérica";
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ewaffle" />
    <meta property="og:locale" content="es_ES" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
    
    <!-- Additional SEO Meta Tags -->
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Ewaffle" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="es" />
    <meta name="geo.region" content="CL" />
    <meta name="geo.placename" content="Santiago, Chile" />
    <meta name="revisit-after" content="7 days" />
    
    <!-- Schema.org Organization Markup -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Ewaffle",
      "url": "https://ewaffle.cl",
      "logo": "https://ewaffle.cl/assets/logoprimario.png",
      "description": description,
      "sameAs": [
        "https://www.instagram.com/ewaffle.cl/",
        "https://linkedin.com/company/ewaffle"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santiago",
        "addressRegion": "RM",
        "addressCountry": "CL"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "alvaro@ewaffle.cl",
        "availableLanguage": "Spanish"
      },
      "areaServed": [
        {
          "@type": "Country",
          "name": "Chile"
        },
        {
          "@type": "Place",
          "name": "Latinoamérica"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios E-learning",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plataforma LMS",
              "url": "https://ewaffle.cl/plataforma"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Journeys de onboarding",
              "url": "https://ewaffle.cl/plataforma"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Chatbots IA",
              "url": "https://ewaffle.cl/ia-chatbots"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Gamificación Avanzada",
              "url": "https://ewaffle.cl/gamificacion"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Producción Multimedia",
              "url": "https://ewaffle.cl/multimedia"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Recursos e-learning premium",
              "url": "https://ewaffle.cl/catalogo"
            }
          }
        ]
      }
    })} />
  </Fragment>
	<!-- 1. Hero Section (Above the fold) -->
	<Hero />
	
	<!-- 2. Sección "Cómo funciona" / Demostración -->
	<Process />
	
	<!-- 3. Services Overview (New) -->
	<ServicesOverview />

	<!-- 3.1 Catálogo vivo -->
	<CatalogSpotlight />

	<!-- 3.2 Servicio destacado -->
	<Onboarding360Spotlight />

	<!-- 3.3 Simuladores -->
	<SimuladoresBanner />
	
	<!-- 4. Bloque de beneficios clave -->
	<Benefits />
	
	<!-- 5. Prueba social -->
	<Testimonials />
	
	<!-- 6. Academia Banner (Middle of page) -->
	<AcademiaBanner />
	
	<!-- 7. Contact Section -->
	<Contact />
	
	<!-- 8. Meet Our Team Section -->
	<MeetOurTeam />
	
	<!-- 9. Technology Showcase (New) -->
	<TechnologyShowcase />
	
	<!-- 10. Use Cases (New) -->
	<UseCases />
	
	<!-- 11. Oferta / Incentivo -->
	<CTA />
	
	<!-- 12. FAQs (Preguntas frecuentes) -->
	<FAQ />
	
	<!-- 13. CTA final -->
	<CTA 
		title="🚀 ¿Aún tienes dudas?"
		subtitle="Agenda una reunión de descubrimiento y ve cómo convertir tu LMS, onboarding y contenidos en una experiencia medible"
		buttonText="Agendar Ahora - Es Gratis"
	/>
	
	<!-- 14. Footer minimalista -->
	<Footer />
</BaseLayout>
