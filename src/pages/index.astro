---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import CatalogBanner from '../components/landing/CatalogBanner.astro';
import ServicesOverview from '../components/landing/ServicesOverview.astro';
import CatalogSpotlight from '../components/landing/CatalogSpotlight.astro';
import Benefits from '../components/landing/Benefits.astro';
import TechnologyShowcase from '../components/landing/TechnologyShowcase.astro';
import UseCases from '../components/landing/UseCases.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import AcademiaBanner from '../components/landing/AcademiaBanner.astro';
import SimuladoresBanner from '../components/landing/SimuladoresBanner.astro';
import MeetOurTeam from '../components/landing/MeetOurTeam.astro';
import Process from '../components/landing/Process.astro';
import Onboarding360Spotlight from '../components/landing/Onboarding360Spotlight.astro';
import OnboardingDigitalBanner from '../components/landing/OnboardingDigitalBanner.astro';
import FAQ from '../components/landing/FAQ.astro';
import Contact from '../components/landing/Contact.astro';
import CTA from '../components/landing/CTA.astro';
import Footer from '../components/landing/Footer.astro';

// SEO Metadata for main landing page
const title = "Ewaffle | Onboarding Digital, plataformas LMS y cursos gamificados";
const description = "Onboarding Digital: la jornada de inducción presencial convertida en un módulo e-learning, con tres planes y precio cerrado. Además LMS marca blanca, cursos gamificados, simuladores y recursos e-learning para universidades, empresas e instituciones.";
const canonicalUrl = "https://ewaffle.cl";
const imageUrl = "https://ewaffle.cl/assets/logoprimario.png";
const keywords = "onboarding digital, inducción digital, inducción de personal, onboarding corporativo, curso de inducción e-learning, inducción a distancia, onboarding para empresas, plataforma LMS para empresas, LMS corporativo, academia corporativa, cursos gamificados, cursos SCORM, recursos e-learning, integración LMS, marca blanca LMS, capacitación interna, universidades, instituciones privadas, e-learning Chile, e-learning Latinoamérica";
---

<BaseLayout {title} {description} {keywords}>
  <Fragment slot="head">
    
    <!-- Additional SEO Meta Tags -->
    <meta name="author" content="Ewaffle" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="es" />
    <meta name="geo.region" content="CL" />
    <meta name="geo.placename" content="Santiago, Chile" />
    <meta name="revisit-after" content="7 days" />
    
    <!-- Schema.org Organization Markup -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Ewaffle",
      "url": "https://ewaffle.cl",
      "logo": "https://ewaffle.cl/assets/logoprimario.png",
      "description": description,
      "sameAs": [
        "https://www.instagram.com/ewaffle.cl/",
        "https://linkedin.com/company/ewaffle"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santiago",
        "addressRegion": "RM",
        "addressCountry": "CL"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "alvaro@ewaffle.cl",
        "availableLanguage": "Spanish"
      },
      "areaServed": [
        {
          "@type": "Country",
          "name": "Chile"
        },
        {
          "@type": "Place",
          "name": "Latinoamérica"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios E-learning",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plataforma LMS",
              "url": "https://ewaffle.cl/plataforma"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Onboarding Digital",
              "alternateName": ["Inducción digital", "Journeys de onboarding", "Curso de inducción e-learning"],
              "description": "Servicio estándar que convierte la jornada de inducción presencial en un módulo e-learning: video de contenido, guía interactiva, cápsula de decisión, material descargable y evaluación certificadora. Entrega en SCORM o HTML en 10 semanas.",
              "serviceType": "Onboarding Digital",
              "url": "https://ewaffle.cl/#onboarding-digital"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Chatbots IA",
              "url": "https://ewaffle.cl/ia-chatbots"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Gamificación Avanzada",
              "url": "https://ewaffle.cl/gamificacion"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Producción Multimedia",
              "url": "https://ewaffle.cl/multimedia"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Recursos e-learning premium",
              "url": "https://ewaffle.cl/catalogo"
            }
          }
        ]
      }
    })} />
  </Fragment>
	<!-- 1. Hero Section (Above the fold) -->
	<!-- Hero + CatalogBanner ocupan exactamente la primera pantalla: el catalogo con
	     cotizador es la via de conversion mas corta y tiene que verse sin scrollear,
	     pero nada mas debe asomar por debajo. -->
	<div class="min-h-[100svh] flex flex-col">
		<Hero />
		<CatalogBanner />
	</div>
	
	<!-- 2. Sección "Cómo funciona" / Demostración -->
	<div id="proceso"></div>
	<Process />
	
	<!-- 3. Services Overview (New) -->
	<ServicesOverview />

	<!-- 3.1 Catálogo vivo -->
	<OnboardingDigitalBanner />

	<CatalogSpotlight />

	<!-- 3.2 Servicio destacado -->
	<Onboarding360Spotlight />

	<!-- 3.3 Simuladores -->
	<SimuladoresBanner />
	
	<!-- 4. Bloque de beneficios clave -->
	<Benefits />
	
	<!-- 5. Prueba social -->
	<Testimonials />
	
	<!-- 6. Academia Banner (Middle of page) -->
	<AcademiaBanner />
	
	<!-- 7. Contact Section -->
	<Contact />
	
	<!-- 8. Meet Our Team Section -->
	<MeetOurTeam />
	
	<!-- 9. Technology Showcase (New) -->
	<TechnologyShowcase />
	
	<!-- 10. Use Cases (New) -->
	<UseCases />
	
	<!-- 11. Oferta / Incentivo -->
	<CTA />
	
	<!-- 12. FAQs (Preguntas frecuentes) -->
	<FAQ />
	
	<!-- 13. CTA final -->
	<CTA 
		title="🚀 ¿Aún tienes dudas?"
		subtitle="Agenda una reunión de descubrimiento y ve cómo convertir tu LMS, onboarding y contenidos en una experiencia medible"
		buttonText="Agendar Ahora - Es Gratis"
	/>
	
	<!-- 14. Footer minimalista -->
	<Footer />
</BaseLayout>
