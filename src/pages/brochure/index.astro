    @media (max-width: 620px) {
      .stats, .grid-2, .pasos, .pasos--contacto { grid-template-columns: 1fr; }
    }

    /* ── Entrada por scroll ── */
    [data-motion] { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity 650ms var(--curva), transform 650ms var(--curva); transition-delay: var(--retardo, 0ms); }
    [data-motion].es-visible { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .sala * { transition-duration: 1ms !important; }
      [data-motion] { opacity: 1 !important; transform: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var animables = Array.prototype.slice.call(document.querySelectorAll("[data-motion]"));
      if (quieto || !("IntersectionObserver" in window)) {
        animables.forEach(function (el) { el.classList.add("es-visible"); });
      } else {
        var ojo = new IntersectionObserver(function (entradas) {
          entradas.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add("es-visible");
            ojo.unobserve(e.target);
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
        animables.forEach(function (el) { ojo.observe(el); });
        /* Red de seguridad: si por lo que sea (tab en segundo plano, salto de
           scroll muy rápido, throttling del navegador) el observer no alcanza
           a disparar, el contenido no puede quedar invisible para siempre. */
        setTimeout(function () {
          animables.forEach(function (el) { el.classList.add("es-visible"); });
          ojo.disconnect();
        }, 2500);
      }

      var secciones = Array.prototype.slice.call(document.querySelectorAll(".escena[id]"));
      var itemsRiel = Array.prototype.slice.call(document.querySelectorAll("[data-riel]"));
      var barra = document.querySelector("[data-barra]");

      function pintarRiel() {
        var alto = document.documentElement.scrollHeight - window.innerHeight;
        var avance = alto <= 0 ? 0 : Math.min(window.scrollY / alto, 1);
        if (barra) barra.style.width = (avance * 100).toFixed(1) + "%";
        var actual = secciones[0];
        var corte = window.innerHeight * 0.34;
        secciones.forEach(function (s) {
          var idAttr = s.id;
          if (idAttr && idAttr.indexOf("f-") === 0) return; // los formatos no tienen ítem propio en el riel
          if (s.getBoundingClientRect().top <= corte) actual = s;
        });
        itemsRiel.forEach(function (a) {
          a.classList.toggle("es-actual", a.getAttribute("data-riel") === actual.id);
        });
      }
      pintarRiel();
      window.addEventListener("scroll", pintarRiel, { passive: true });
      window.addEventListener("resize", pintarRiel);

      /* Scroll suave al hacer clic en el riel — un salto instantáneo a una
         sección lejana en un documento tan largo puede dejar el navegador
         pintando de menos por un instante; recorrer la distancia de a poco
         evita ese parpadeo y además se siente mejor. */
      itemsRiel.forEach(function (a) {
        a.addEventListener("click", function (ev) {
          var destino = document.getElementById(a.getAttribute("data-riel"));
          if (!destino) return;
          ev.preventDefault();
          history.pushState(null, "", "#" + a.getAttribute("data-riel"));
          destino.scrollIntoView({ behavior: quieto ? "auto" : "smooth", block: "start" });
        });
      });
    })();
  </script>
