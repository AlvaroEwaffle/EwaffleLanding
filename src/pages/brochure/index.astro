    .deco--haz2 { width: 300px; height: 300px; background: var(--haz); border-radius: 50%; bottom: -120px; right: -100px; opacity: .15; }
    .deco--rosa2 { width: 200px; height: 200px; background: var(--rosa); border-radius: 50%; top: -80px; left: -80px; opacity: .12; }

