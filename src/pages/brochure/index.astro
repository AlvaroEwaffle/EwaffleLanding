    /* ── Riel ── */
    .riel { position: fixed; top: 0; right: 0; height: 100vh; width: 210px; display: flex; flex-direction: column; padding: 34px 22px; z-index: 20; background: linear-gradient(180deg, rgba(10,8,18,.6), rgba(10,8,18,.3)); backdrop-filter: blur(6px); border-left: 1px solid var(--linea); }
    .riel__marca { font-family: "IBM Plex Mono", monospace; font-weight: 700; font-size: 13px; letter-spacing: .1em; color: var(--tiza); text-decoration: none; margin-bottom: 30px; }
    .riel__lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; flex: 1; }
    .riel__item { display: flex; align-items: baseline; gap: 8px; text-decoration: none; padding: 8px 10px; border-radius: 8px; color: var(--niebla); font-size: 12.5px; transition: background .2s, color .2s; }
    .riel__item:hover { background: rgba(255,255,255,.05); }
    .riel__item.es-actual { background: rgba(253,90,147,.1); color: var(--tiza); }
    .riel__n { font-family: "IBM Plex Mono", monospace; font-size: 10px; color: var(--rosa); }
    .riel__barra { height: 3px; background: var(--linea); border-radius: 3px; overflow: hidden; margin-top: 10px; }
    .riel__barra span { display: block; height: 100%; width: 0%; background: linear-gradient(90deg, var(--rosa), var(--haz)); transition: width .1s linear; }

    @media (max-width: 980px) {
      .riel { width: 100%; height: auto; flex-direction: row; align-items: center; padding: 12px 18px; border-left: none; border-bottom: 1px solid var(--linea); }
      .riel__marca { margin: 0 16px 0 0; }
