---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Brochure Ewaffle | Formación digital para empresas";
const description = "Producción e-learning, diseño instruccional y multimedia premium: 7 formatos, un curso estándar de 4 módulos y una plataforma LMS 100% a tu medida.";

/* ── Recorrido (riel) ─────────────────────────────────────────────────── */
const escenas = [
  { id: "portada", n: "00", t: "Inicio" },
  { id: "quienes", n: "01", t: "Quiénes somos" },
  { id: "metodo", n: "02", t: "Cómo trabajamos" },
  { id: "formatos", n: "03", t: "Formatos" },
  { id: "estandar", n: "04", t: "Nuestro estándar" },
  { id: "plataforma", n: "05", t: "Plataforma LMS" },
  { id: "contacto", n: "06", t: "Contacto" },
];

/* ── Clientes ─────────────────────────────────────────────────────────── */
const clientes = [
  { name: "ACHS", logo: "/assets/clientlogos/ACHS.svg", asis: true },
  { name: "AIEP", logo: "/assets/clientlogos/AIEP.svg" },
  { name: "Duoc UC", logo: "/assets/clientlogos/Duoc UC.svg" },
  { name: "Universidad Santo Tomás", logo: "/assets/clientlogos/UST.svg" },
  { name: "Universidad Gabriela Mistral", logo: "/assets/clientlogos/Universidad Gabriela Mistral.svg" },
  { name: "UNIACC", logo: "/assets/clientlogos/UNIACC.svg" },
  { name: "Buffalo Waffles", logo: "/assets/clientlogos/Buffalo.webp", asis: true },
  { name: "Progreso", logo: "/assets/clientlogos/Progreso.png" },
];
const otrosClientes = ["LATAM Airlines", "Manpower", "Coanil", "Fundación Oportunidad", "Fundación Las Rosas", "Colegios SIP", "CERP", "Adecco", "Sernatur", "Compin"];

/* ── Método ───────────────────────────────────────────────────────────── */
const metodo = [
  { n: "01", t: "Diagnóstico", d: "Entendemos el contenido, la audiencia y la conducta que tiene que cambiar." },
  { n: "02", t: "Diseño", d: "Guión instruccional y estructura de módulos. ~4 días tras aprobar tu contenido.", nota: "Incluye 1 ronda de ajustes." },
  { n: "03", t: "Producción", d: "Video, Rise, Storyline y material extra. ~5-7 días tras aprobar el diseño.", nota: "Incluye 2 rondas de ajustes." },
  { n: "04", t: "Implementación", d: "Empaquetado SCORM, carga en tu LMS (o el nuestro) y QA de navegación." },
  { n: "05", t: "Medición", d: "Avance, resultados y ajustes para la siguiente cohorte o curso." },
];

/* ── Los siete formatos ───────────────────────────────────────────────── */
const formatos = [
  {
    id: "f-video", n: "01", grupo: "Audiovisual", titulo: "Videos formativos",
    texto: "La pieza que abre el módulo y la que se reenvía cuando cambia un procedimiento. Producimos cuatro variantes bajo un mismo nombre: a cámara con tu gente, animado en motion graphics, de módulo con locución controlada, o con actor profesional. Cuál conviene lo decide el contenido.",
    bullets: ["Locución en español neutro o chileno, con el énfasis puesto donde importa.", "Subtitulado, corte largo para el LMS y versión vertical para difusión interna.", "Cuando cambia el procedimiento se rehace el tramo, no el video completo."],
    img: "/assets/catalogo/video-induccion.webp",
    ejemplos: [
      { t: "Módulo de inducción", href: "https://tefi.villelab.com/buffalo-m1-v8.3-HD.mp4", modo: "▶" },
      { t: "Cápsula normativa", href: "https://tefi.villelab.com/achs-pnce-HD.mp4", modo: "▶" },
      { t: "Pieza animada", href: "https://youtu.be/rf5-fAPg9wU", modo: "▶" },
      { t: "Video con actor", href: "https://drive.google.com/file/d/1hKQp1twOOka8PY_hYZMCGAmktgcZ9p-b/preview", modo: "↗" },
    ],
  },
  {
    id: "f-guias", n: "02", grupo: "Contenido", titulo: "Guías interactivas",
    texto: "El manual que nadie abre, convertido en algo que se recorre y se termina. Se abre en el navegador, sin instalar nada y sin crear cuenta — un trabajador nuevo puede hacer su inducción el primer día sin esperar un acceso de TI.",
    bullets: ["Para inducción, procedimientos y onboarding de contratistas.", "Índice, barra de avance y memoria de dónde quedó. Igual en celular, tablet y escritorio.", "Se entrega como SCORM para tu LMS o como enlace directo, según dónde viva."],
    img: "/assets/catalogo/guias.webp",
    imgPos: "left center",
    ejemplos: [
      { t: "Recorrer la guía completa", href: "/demos/buffalo-induccion.html", modo: "⧉" },
      { t: "La versión con actividades", href: "/demos/buffalo-induccion-juegos.html", modo: "⧉" },
      { t: "Ejemplo en Articulate Rise", href: "https://360.articulate.com/review/content/d0260191-6bb2-4656-9524-5bc9c615cb9f/review", modo: "↗" },
    ],
  },
  {
    id: "f-capsulas", n: "03", grupo: "Criterio", titulo: "Cápsulas interactivas",
    texto: "Escenarios ramificados para los temas donde ninguna opción es gratis — buen trato, ética, prevención, autonomía. La persona elige, ve la consecuencia y recibe el porqué, que es la parte que después se repite en el puesto.",
    bullets: ["Trabaja los dilemas reales del puesto, levantados con tu gente, no casos de manual.", "Sin respuestas obvias: cada camino tiene un costo defendible.", "Estándar Articulate Storyline, con la retroalimentación dentro del propio recurso."],
    img: "/assets/brochure/waffle-quest.webp",
    ejemplos: [
      { t: "Árbol de decisiones · ACHS DS44", href: "/demo-scorm/arbol-decision/story.html", modo: "⧉" },
      { t: "Cápsula ramificada propia", href: "/demos/buffalo-protocolo-atencion.html", modo: "⧉" },
      { t: "Otro ejemplo Storyline", href: "https://360.articulate.com/review/content/5b3fb8d6-cecd-4f2c-84af-bf83b785ebfc/review", modo: "↗" },
    ],
  },
  {
    id: "f-simuladores", n: "04", grupo: "Simulación", titulo: "Simuladores",
    texto: "Practican la operación completa antes de tocar una real. Cada participante entra con un rol distinto y si los papeles no cuadran, la operación no avanza — el error sale gratis acá y caro en el puesto. Desarrollo propio: no pagas licencia de plataforma por usuario.",
    bullets: ["Trabajan sobre documentación y procesos reales — la respuesta está en el expediente, así que entrenan criterio y no memoria.", "Multijugador: lo que se entrena es la coordinación entre roles, no una tarea suelta."],
    img: "/assets/catalogo/simuladores.webp",
    ejemplos: [
      { t: "Ver cómo funciona", href: "https://tefi.villelab.com/comex-live-explainer.mp4", modo: "▶" },
      { t: "Simulador Buffalo Waffles", href: "https://tefi.villelab.com/buffalo-sim.html", modo: "⧉" },
      { t: "Simulador de comercio exterior", href: "https://comex.villelab.com/sim?modo=dirigido", modo: "⧉" },
    ],
  },
  {
    id: "f-tour360", n: "05", grupo: "Inmersivo", titulo: "Recorridos 360°",
    texto: "Que reconozcan la planta antes del primer turno. La información aparece justo donde está el riesgo, en vez de en un anexo que se lee lejos del lugar — la inducción presencial se acorta porque la gente llega ubicada.",
    bullets: ["Para inducciones de planta, prevención de riesgos y visitas de contratistas.", "Se navega desde el navegador o con visor; no hay que instalar una aplicación.", "Se considera dentro de una jornada de grabación en terreno — no es una línea de costo aparte."],
    img: "/assets/catalogo/tour360.webp",
    ejemplos: [
      { t: "Recorrido interactivo", href: "https://storage.net-fs.com/hosting/2727323/380/index.htm", modo: "⧉" },
      { t: "Recorrido en video", href: "https://youtu.be/7iaJIuOoxzE", modo: "▶" },
      { t: "Nuestro servicio 360°", href: "/servicio-360/", modo: "↗" },
    ],
  },
  {
    id: "f-ludicas", n: "06", grupo: "Práctica", titulo: "Actividades lúdicas",
    texto: "Ocho mecánicas ya construidas y probadas, listas para cargar tu contenido: ruleta, memorice, millonario, sopa de letras, rueda de conceptos, arrastrar y soltar, ubicación en plano y árbol de decisiones. El presupuesto se va en adaptar tu contenido, no en desarrollar desde cero.",
    bullets: ["Se arman con los conceptos reales de tu programa, no con ejemplos genéricos.", "Sin nota al LMS y con reintentos ilimitados: se practica sin miedo a reprobar."],
    img: "/assets/catalogo/juegos.webp",
    ejemplos: [
      { t: "Jugar la demo", href: "/demos/juegos-demo.html", modo: "⧉" },
      { t: "Ver las ocho mecánicas", href: "/demos/juegos-referencia.html", modo: "⧉" },
      { t: "Ubicación en plano", href: "/demos/hotspot-plano-prototipo.html", modo: "⧉" },
    ],
  },
  {
    id: "f-terreno", n: "07", grupo: "En terreno", titulo: "Producción en terreno",
    texto: "Tus espacios, tus equipos y tu gente, grabados donde ocurre el trabajo. Un caso genérico no le habla a alguien que trabaja ahí todos los días — se nota desde la primera pantalla.",
    bullets: ["Para demostraciones de procedimiento, testimonios y recorridos de planta.", "Grabamos en tu instalación con el equipo operando, y en set cuando conviene.", "Se cotiza por jornada, y una jornada bien planificada alimenta varios módulos."],
    img: "/assets/catalogo/terreno.webp",
    ejemplos: [
      { t: "Ver ejemplo en terreno", href: "https://youtu.be/OCu-5fmS_mI", modo: "▶" },
      { t: "Otro ejemplo (Drive)", href: "https://drive.google.com/file/d/1hKQp1twOOka8PY_hYZMCGAmktgcZ9p-b/view", modo: "↗" },
    ],
  },
];

/* ── Nuestro estándar: precios ────────────────────────────────────────── */
const tiers = [
  { id: "esencial", t: "Esencial", precio: 1120000, incluye: [true, true, false, false, true] },
  { id: "estandar", t: "Estándar", reco: true, precio: 1960000, incluye: [true, true, true, true, true] },
];
const filasIncluye = ["Video formativo", "Guía interactiva (6 capítulos)", "Cápsula interactiva", "Material extra descargable", "Entrega SCORM para tu LMS"];

const volumen = [
  { rango: "1", pct: null },
  { rango: "2–4", pct: 4 },
  { rango: "5–10", pct: 6 },
  { rango: "11+", pct: 8 },
];

const addonsCurso = [
  { t: "Diagnóstico y diseño de la experiencia", p: 570000 },
  { t: "Prototipo probado con 5 usuarios", p: 470000 },
  { t: "Levantamiento de contenido con experto", p: 570000 },
  { t: "Jornada de grabación en terreno", p: 770000 },
  { t: "Locución profesional en todo el curso", p: 350000 },
  { t: "Evaluación final tipo caso (30 preguntas)", p: 87000 },
];
const addonsModulo = [
  { t: "Cápsula interactiva adicional", p: 470000 },
  { t: "Actividades lúdicas adicionales", p: 250000 },
  { t: "Versión en portugués (PT-BR)", p: 540000 },
  { t: "Simulador", p: 570000 },
];

/* ── Plataforma LMS ───────────────────────────────────────────────────── */
const lmsFeatures = [
  { t: "Marca blanca", d: "Dominio, colores y logo propios — sin rastro de Ewaffle." },
  { t: "Tus canales", d: "Email, WhatsApp o el que ya uses para avisar y recordar." },
  { t: "Integraciones", d: "SSO, HRIS, ERP — conecta con lo que ya tienes." },
  { t: "Escalable", d: "Arranca con un piloto chico y crece con tus usuarios." },
];
const lmsImpl = [
  { t: "Starter", d: "LMS con marca, 1 canal, dashboard básico", p: "$1.140.000–$2.280.000" },
  { t: "Standard", d: "+ multicanal, multi-rol, 30% dcto. producción", p: "$2.570.000–$5.130.000" },
  { t: "Enterprise", d: "Integraciones a medida, AM dedicado", p: "A medida" },
];
const lmsMensual = [
  { t: "Hasta 500", p: "$190.000" },
  { t: "501 – 2.500", p: "$480.000" },
  { t: "2.501 – 10.000", p: "$1.140.000" },
  { t: "10.001 – 30.000", p: "$2.380.000" },
  { t: "30.000+", p: "Contactar" },
];

function clp(n) { return "$" + n.toLocaleString("es-CL"); }
---

<BaseLayout title={title} description={description} image="/assets/catalogo-og.png">
  <Fragment slot="head">
    <meta name="theme-color" content="#0a0812" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
  </Fragment>

  <div class="sala" id="sala">
    <aside class="riel" aria-label="Avance del recorrido">
      <a href="/" class="riel__marca">EWAFFLE</a>
      <ol class="riel__lista">
        {escenas.map((e) => (
          <li><a href={`#${e.id}`} class="riel__item" data-riel={e.id}><span class="riel__n">{e.n}</span><span class="riel__t">{e.t}</span></a></li>
        ))}
      </ol>
      <div class="riel__barra" aria-hidden="true"><span data-barra></span></div>
    </aside>

    <main class="cinta">

      <!-- ══ 00 · PORTADA ══ -->
      <section class="escena escena--apertura" id="portada">
        <div class="deco deco--rosa"></div>
        <div class="deco deco--haz"></div>
        <p class="claqueta" data-motion>Formación digital para empresas</p>
        <h1 class="titular" data-motion style="--retardo: 90ms;">Convertimos tu contenido<br />en experiencias que se <em>recuerdan y se aplican</em></h1>
        <p class="bajada" data-motion style="--retardo: 180ms;">LMS marca blanca, journeys de onboarding, cursos gamificados y producción multimedia premium — sin necesidad de equipo técnico interno.</p>
        <div class="acciones" data-motion style="--retardo: 260ms;">
          <a href="#formatos" class="boton boton--primario">Ver los 7 formatos<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7" /></svg></a>
          <a href="#estandar" class="boton boton--fantasma">Ver precios</a>
        </div>
      </section>

      <!-- ══ 01 · QUIÉNES SOMOS ══ -->
      <section class="escena" id="quienes">
        <p class="claqueta" data-motion>01 · Quiénes somos</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">Producimos <em>formación digital</em><br />para empresas, de punta a punta</h2>
        <p class="parrafo" data-motion style="--retardo: 140ms;">Diseñamos el contenido, lo producimos en los formatos que corresponden y lo dejamos funcionando en tu LMS — o en el nuestro. Un mismo equipo desde el diagnóstico hasta la entrega en SCORM.</p>

        <div class="stats" data-motion style="--retardo: 200ms;">
          <div class="stat"><b class="haz">50+</b><span>empresas confían en Ewaffle — salud, aviación, retail y educación superior</span></div>
          <div class="stat"><b class="rosa">+200</b><span>cursos generados con nuestro equipo, desde módulos sueltos hasta programas completos</span></div>
          <div class="stat"><b class="azul">7</b><span>formatos de producción, combinables según el objetivo de aprendizaje</span></div>
          <div class="stat"><b>100%</b><span>compatibilidad SCORM 1.2 / 2004 con cualquier LMS existente</span></div>
        </div>

        <p class="etiqueta" data-motion style="--retardo: 240ms;">Algunos clientes con quienes trabajamos</p>
        <div class="logos" data-motion style="--retardo: 280ms;">
          {clientes.map((c) => (
            <div class="logochip"><img class={c.asis ? "asis" : ""} src={c.logo} alt={c.name} loading="lazy" /></div>
          ))}
        </div>
        <div class="namechips" data-motion style="--retardo: 320ms;">
          {otrosClientes.map((n) => <span class="namechip">{n}</span>)}
        </div>
      </section>

      <!-- ══ 02 · CÓMO TRABAJAMOS ══ -->
      <section class="escena" id="metodo">
        <p class="claqueta" data-motion>02 · Cómo trabajamos</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">Un método, no una<br />lista de <em>servicios</em></h2>

        <div class="pasos" data-motion style="--retardo: 140ms;">
          {metodo.map((m, i) => (
            <div class="paso">
              <div class={`circn ${i % 2 ? "g" : ""}`}>{m.n}</div>
              <b>{m.t}</b>
              <span>{m.d} {m.nota && <strong class="haz">{m.nota}</strong>}</span>
            </div>
          ))}
        </div>

        <div class="tiempos" data-motion style="--retardo: 220ms;">
          <div class="tiempos__cifra"><b class="haz">3–5</b><span>semanas / módulo</span></div>
          <div class="tiempos__texto">
            <p><strong class="tiza">⏱ Nuestros tiempos.</strong> Nuestro trabajo directo toma ~15 días hábiles (3 semanas); el resto del rango depende de cuánto se demore tu equipo en entregar y validar contenido.</p>
            <div class="pasitos">
              <span class="pasito">Entrega de contenido</span><span class="flecha">→</span>
              <span class="pasito">Revisión<b>2 días</b></span><span class="flecha">→</span>
              <span class="pasito">Diseño instruccional<b>4 días</b></span><span class="flecha">→</span>
              <span class="pasito">Validación<b>2 días</b></span><span class="flecha">→</span>
              <span class="pasito">Diseño multimedia<b>5 días</b></span><span class="flecha">→</span>
              <span class="pasito">Validación final<b>2 días</b></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ 03 · FORMATOS ══ -->
      <section class="escena escena--intro" id="formatos">
        <p class="claqueta" data-motion>03 · Formatos</p>
        <h2 class="titular titular--mediano" data-motion style="--retardo: 80ms;">7 <em>Formatos</em></h2>
        <p class="parrafo" data-motion style="--retardo: 140ms;">Todo lo que producimos, en un solo lenguaje — se combinan según el objetivo de aprendizaje, no al revés.</p>
        <div class="mini-nav" data-motion style="--retardo: 200ms;">
          {formatos.map((f) => <a href={`#${f.id}`} class="mini-nav__item"><span>{f.n}</span>{f.titulo}</a>)}
        </div>
      </section>

      {formatos.map((f, i) => (
        <section class="escena escena--formato" id={f.id}>
          <div class="formato__texto">
            <p class="claqueta" data-motion>03 · Formatos — {f.n}/07 · {f.grupo}</p>
            <h3 class="rubro rubro--chico" data-motion style="--retardo: 60ms;" set:html={f.titulo.replace(/(interactiv[oa]s?|formativos|360°|lúdicas|terreno)$/i, "<em>$1</em>")} />
            <p class="parrafo parrafo--chico" data-motion style="--retardo: 100ms;">{f.texto}</p>
            <div class="lista-bullets" data-motion style="--retardo: 140ms;">
              {f.bullets.map((b) => <div class="bullet">{b}</div>)}
            </div>
            <div class="ejemplos" data-motion style="--retardo: 180ms;">
              <span class="ejemplos__label">Ejemplos</span>
              <div class="ejemplos__fila">
                {f.ejemplos.map((e) => <a class="chip-ejemplo" href={e.href} target="_blank" rel="noreferrer"><span>{e.modo}</span>{e.t}</a>)}
              </div>
            </div>
          </div>
          <div class="formato__imagen" data-motion style="--retardo: 100ms;">
            <img src={f.img} alt={f.titulo} loading="lazy" style={f.imgPos ? `object-position:${f.imgPos};` : ""} />
          </div>
        </section>
      ))}

      <!-- ══ 04 · NUESTRO ESTÁNDAR ══ -->
      <section class="escena" id="estandar">
        <p class="claqueta" data-motion>04 · Nuestro estándar</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">Costos por <em>módulo</em></h2>
        <p class="parrafo" data-motion style="--retardo: 140ms;">Aprox. 4 horas de contenido por módulo — elige el tipo con el que arrancamos la mayoría de los programas.</p>

        <div class="tabla-wrap" data-motion style="--retardo: 200ms;">
          <table class="compare">
            <thead>
              <tr>
                <th class="col-label">Incluye</th>
                {tiers.map((tier) => <th class={tier.reco ? "reco" : ""}>{tier.t}{tier.reco && <span class="pill-reco">Recomendado</span>}</th>)}
              </tr>
            </thead>
            <tbody>
              {filasIncluye.map((fila, idx) => (
                <tr>
                  <td class="col-label">{fila}</td>
                  {tiers.map((tier) => <td class={`chk ${tier.reco ? "reco" : ""} ${!tier.incluye[idx] ? "dim" : ""}`}>{tier.incluye[idx] ? "✓" : "–"}</td>)}
                </tr>
              ))}
              <tr class="fila-total">
                <td class="col-label">Precio por módulo</td>
                {tiers.map((tier) => <td class={`num ${tier.reco ? "reco" : ""}`}>{clp(tier.precio)}</td>)}
              </tr>
            </tbody>
          </table>
        </div>
        <p class="nota-fina" data-motion style="--retardo: 240ms;">CLP · exento de IVA · pago 50% al inicio + 50% contra entrega · validez 30 días · plazo 3-5 semanas por módulo.</p>

        <div class="grid-2" data-motion style="--retardo: 280ms;">
          <div class="bloque">
            <h4>Descuento por volumen</h4>
            <table class="mini-tabla">
              <tbody>
                {volumen.map((v) => <tr><td>{v.rango} módulo{v.rango !== "1" ? "s" : ""}</td><td class="num">{v.pct ? `−${v.pct}%` : "—"}</td></tr>)}
              </tbody>
            </table>
            <p class="nota-fina">Aplica sobre el precio de módulo, no sobre los add-ons. Ejemplo: 4 módulos estándar (${(1960000).toLocaleString("es-CL")} c/u) con −4% = {clp(7530000)}.</p>
          </div>
          <div class="bloque">
            <h4>Qué le agregas</h4>
            <table class="mini-tabla">
              <tbody>
                {addonsCurso.map((a) => <tr><td>{a.t}</td><td class="num">{clp(a.p)}</td></tr>)}
                {addonsModulo.map((a) => <tr><td>{a.t} <em class="por-modulo">/módulo</em></td><td class="num">{clp(a.p)}</td></tr>)}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ══ 05 · PLATAFORMA LMS ══ -->
      <section class="escena" id="plataforma">
