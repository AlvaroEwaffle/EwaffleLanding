      <!-- ══ ESCENA 04 · Cómo se produce ═══════════════════════════════════ -->
      <section class="escena" id="produccion">
        <p class="claqueta" data-motion>04 · Cómo se hace</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">
          Cuatro etapas.<br /><em>La primera no es grabar.</em>
