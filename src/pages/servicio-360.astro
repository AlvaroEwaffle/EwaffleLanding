        </figure>
      </section>

      <!-- ══ ESCENA 05 · Cómo se entrega ═══════════════════════════════════ -->
      <section class="escena escena--ancha" id="entrega">
        <p class="claqueta" data-motion>05 · Cómo se entrega</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">
          Tiene que abrirse el primer día,<br /><em>sin pedirle nada a TI.</em>
        </h2>

        <div class="entrega">
