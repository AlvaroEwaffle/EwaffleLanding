---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/landing/Footer.astro';
import Contact from '../components/landing/Contact.astro';

/* ═══════════════════════════════════════════════════════════════════════════
   SERVICIO 360 · el recorrido antes del lugar
   ───────────────────────────────────────────────────────────────────────────
   La versión anterior explicaba el servicio entera con texto: seis secciones
   de prosa, cuatro tarjetas de "qué incluye" y un bloque de demostraciones
   donde cada ejemplo era un botón que se iba a otra pestaña. El problema es el
   mismo que tenía el catálogo antes de rehacerse: vendemos una experiencia que
   se recorre y la página pedía que nos creyeran de palabra.

   Acá cambian tres cosas:

   1. SE VE. La página muestra el recorrido en vez de describirlo — el video
      360 de la planta va incrustado y se arrastra con el mouse en la misma
      página, y el recorrido navegable se abre en un visor sin salir de acá.
   2. RESPONDE LA PRIMERA PREGUNTA. "¿En qué se diferencia de un video?" era lo
      único que el texto anterior no contestaba de frente. Ahora es la escena
      01 y es una comparación fila por fila.
   3. HEREDA EL LENGUAJE DEL CATÁLOGO. Misma sala oscura, mismo riel de avance,
      mismo visor, misma tipografía. Es la página hermana de /catalogo, no una
      página suelta con otro aire.

   Honestidad de las referencias — esto no se toca sin verificar:
     · El recorrido navegable es el TOUR DE MUESTRA DE 3DVISTA. Es la
       tecnología con la que producimos, no un proyecto nuestro, y la página lo
       dice en su propia tarjeta. El catálogo lo rotula igual.
     · El video 360 de Planta Arauco (Logmeter) sí es un recorrido de
       producción propia.
     · La pieza a cámara es producción en terreno, no un 360. Va en la sección
       de producción, nunca entre los ejemplos de recorrido.
   ═══════════════════════════════════════════════════════════════════════════ */

const title = "Recorridos 360 para inducción y onboarding | Ewaffle";
const description = "Recorridos 360, video inmersivo y producción en terreno para que tu equipo reconozca la planta, la sala o la faena antes de pisarla. Ejemplos navegables, entrega en navegador, visor o SCORM.";

/* La cabecera de la página emitía su propio `canonical` y su propia `og:image`,
   y BaseLayout ya emite las dos antes: los lectores de enlaces se quedan con la
   primera, así que las de acá nunca llegaban a ninguna parte. Se fueron; queda
   solo el JSON-LD, que sí es aporte propio de esta página. */
const canonicalUrl = "https://www.ewaffle.cl/servicio-360";

const escenas = [
  { id: "apertura",   n: "00", t: "Inicio" },
  { id: "diferencia", n: "01", t: "Qué es" },
  { id: "usos",       n: "02", t: "Para qué sirve" },
  { id: "ejemplos",   n: "03", t: "Ejemplos" },
  { id: "produccion", n: "04", t: "Cómo se hace" },
  { id: "entrega",    n: "05", t: "Cómo se entrega" },
  { id: "cierre",     n: "06", t: "Conversemos" },
];

/* ── Escena 01 · La comparación ───────────────────────────────────────────
   Cuatro ejes, ninguno sobre métricas: lo que un recorrido registra depende de
   cómo se entregue, y prometer analítica en una tabla de venta es prometer algo
   que después hay que sostener en la reunión. */
const comparativa = [
  {
    eje: "Quién decide hacia dónde se mira",
    video: "El montaje. Se ve lo que el editor eligió mostrar, en el orden que eligió.",
    tour: "La persona. Gira, se acerca y vuelve a mirar la zona que le quedó dudosa.",
  },
  {
    eje: "Dónde queda la información",
    video: "En la narración. Pasa una vez y hay que rebobinar para recuperarla.",
    tour: "Anclada al punto donde ocurre: el aviso vive sobre el equipo, no en un anexo aparte.",
  },
  {
    eje: "Qué pasa cuando cambia algo",
    video: "Se rehace el tramo y se vuelve a exportar la pieza.",
    tour: "Se corrige el punto afectado y el resto del recorrido queda como estaba.",
  },
  {
    eje: "Cómo se usa en la inducción",
    video: "Se proyecta o se envía, y todos ven lo mismo en el mismo orden.",
    tour: "Cada uno lo recorre a su ritmo antes de llegar, y vuelve a abrirlo cuando tiene una duda concreta.",
  },
];

/* ── Escena 02 · Los usos ─────────────────────────────────────────────────
   Escritos como la situación con la que llega el cliente, no como la categoría
   con la que la clasificamos nosotros. */
const usos = [
  {
    n: "01",
    t: "Inducción de planta y primer turno",
    d: "Quien entra ya sabe dónde está el vestidor, por dónde se accede a producción y qué zona no se cruza sin autorización.",
    detalle: "La inducción presencial deja de gastarse en ubicar gente y se usa en lo que solo se puede explicar parado en el lugar.",
  },
  {
    n: "02",
    t: "Prevención de riesgos",
    d: "El aviso queda pegado al punto donde está el riesgo: la máquina, el desnivel, el tablero, la zona de tránsito de grúas.",
    detalle: "Deja de ser un anexo del reglamento que se lee lejos de donde importa.",
  },
  {
    n: "03",
    t: "Visitas de contratistas y proveedores",
    d: "El que viene por dos días recorre la instalación antes de entrar, con las reglas puestas donde corresponde.",
    detalle: "No hay que montarle un programa completo de inducción para una visita corta.",
  },
  {
    n: "04",
    t: "Una misma entrada en varias sedes",
    d: "Con turnos, sucursales o faenas distintas, el recorrido fija el mismo estándar de ingreso para todas.",
    detalle: "El estándar deja de depender de quién esté disponible ese día para hacer el tour a mano.",
  },
];

/* ── Escena 04 · Producción ───────────────────────────────────────────── */
const produccion = [
  {
    n: "01",
    t: "Levantamiento y guión del recorrido",
    d: "Vamos a la instalación, definimos por dónde entra la persona, qué puntos son críticos y qué tiene que quedar sabiendo al final. El orden del recorrido es una decisión de diseño instruccional, no de cámara.",
  },
  {
    n: "02",
    t: "Captura en terreno",
    d: "Fotografía o video 360 en los puntos definidos, con la operación andando cuando es parte de lo que hay que mostrar. Una jornada bien planificada cubre más superficie de la que uno espera.",
  },
  {
    n: "03",
    t: "Capas explicativas",
    d: "Sobre el recorrido montamos lo que lo convierte en aprendizaje: narración, textos, hotspots, placas de advertencia y saltos entre zonas. Sin esto un 360 es una postal navegable.",
  },
  {
    n: "04",
    t: "Armado y prueba",
    d: "Se arma el recorrido completo, se prueba en celular y en escritorio, y se corrige lo que no se entiende antes de entregarlo. Cuando el recorrido acompaña a un curso, se amarra ahí.",
  },
];

/* ── Escena 05 · Entrega ──────────────────────────────────────────────── */
const entregas = [
  {
    t: "En el navegador",
    d: "Se abre con un enlace, sin instalar aplicación y sin crear cuenta. Es la vía por la que entra casi todo el mundo: computador de la oficina o el celular del trabajador.",
  },
  {
    t: "Con visor",
    d: "El mismo recorrido se puede ver con un visor cuando la inducción se hace en sala y se quiere el efecto inmersivo completo.",
  },
  {
    t: "Dentro de tu LMS",
    d: "Se empaqueta como SCORM para que viva junto al resto del programa y el LMS registre el avance, o queda como enlace directo si tu inducción no pasa por una plataforma.",
  },
];

/* Cuándo conviene puro y cuándo mezclado. Se mantiene de la versión anterior
   porque es la pregunta que llega en la primera reunión, pero deja de ser una
   sección propia: vive en el cierre, que es donde se decide. */
const decision = [
  {
    t: "Conviene un recorrido 360",
    tono: "si",
    puntos: [
      "Cuando el espacio físico es parte de lo que hay que aprender.",
      "Cuando reconocer el lugar antes de llegar reduce dudas y accidentes de novato.",
      "Cuando la misma inducción se repite en varias sedes y hoy sale distinta en cada una.",
    ],
  },
  {
    t: "Conviene mezclarlo",
    tono: "mezcla",
    puntos: [
      "Cuando además hay procedimiento que explicar: ahí entra el video o la guía interactiva.",
      "Cuando hay que comprobar que entendieron, con una actividad de ubicación en plano o un chequeo corto.",
      "Cuando el recorrido tiene que convivir con un programa formativo completo dentro del LMS.",
    ],
  },
];

const agendaUrl = "https://capu.villelab.com/schedule/reunion-descubrimiento-con-alvaro/";
const araucoId = "7iaJIuOoxzE";
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <meta name="theme-color" content="#0a0812" />
    <!-- Sin `color-scheme: dark` acá, a diferencia del catálogo: esta página
         termina en el formulario de contacto, que es claro y usa los controles
         por defecto del navegador. Declarada oscura, el navegador le pintaba a
         esos campos un fondo gris carbón sobre la tarjeta blanca. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Recorridos 360 para inducción y onboarding",
      "provider": {
        "@type": "Organization",
        "name": "Ewaffle",
        "url": "https://www.ewaffle.cl",
        "logo": "https://www.ewaffle.cl/assets/logoewchico.png"
      },
      "areaServed": { "@type": "Place", "name": "Chile y Latinoamérica" },
      "url": canonicalUrl,
      "description": description,
      "name": title
    })} />
  </Fragment>

  <div class="sala" id="sala">

    <!-- ══ Riel ══ El mismo índice-y-avance del catálogo. Fijo al costado en
         escritorio; bajo 1180px queda como franja delgada arriba. -->
    <aside class="riel" aria-label="Avance de la página">
      <a href="/" class="riel__marca">EWAFFLE</a>
      <ol class="riel__lista">
        {escenas.map((e) => (
          <li>
            <a href={`#${e.id}`} class="riel__item" data-riel={e.id}>
              <span class="riel__n">{e.n}</span>
              <span class="riel__t">{e.t}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="riel__cuenta">Servicio 360</p>
      <div class="riel__barra" aria-hidden="true"><span data-barra></span></div>
    </aside>

    <main class="cinta">

      <!-- ══ ESCENA 00 · Apertura ══════════════════════════════════════════ -->
      <section class="escena escena--apertura" id="apertura">
        <div class="apertura__fondo" aria-hidden="true">
          <!-- Desenfocado a propósito: el fotograma trae el título del tour de
               muestra quemado encima y nítido competiría con el titular — y,
               peor, se leería como si el proyecto fuera nuestro. Lo que aporta
               es la luz, no sus palabras. -->
          <img src="/assets/catalogo/tour360.webp" alt="" width="1100" height="688" fetchpriority="high" decoding="async" />
        </div>

        <div class="apertura__reja">
          <div class="apertura__cuerpo">
            <p class="claqueta" data-motion>
              <span class="claqueta__punto" aria-hidden="true"></span>
              Servicio 360 · Inducción y onboarding en terreno
            </p>
            <h1 class="titular" data-motion style="--retardo: 90ms;">
              Que reconozcan el lugar<br /><em>antes de pisarlo.</em>
            </h1>
            <p class="bajada" data-motion style="--retardo: 180ms;">
              Producimos recorridos 360, video inmersivo y registro en terreno para que la
              persona entienda la planta, la sala o la faena antes del primer turno. La
              información queda puesta donde ocurre —sobre el equipo, en la zona de riesgo, en
              el punto de encuentro— y no en un anexo que se lee lejos del lugar.
            </p>
            <div class="acciones" data-motion style="--retardo: 260ms;">
              <a href="#ejemplos" class="boton boton--primario" data-cta="ejemplos">
                Ver los ejemplos
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
              </a>
              <a href="#contact" class="boton boton--fantasma" data-cta="contacto_hero">
                Evaluarlo para mi operación
              </a>
            </div>
            <dl class="datos" data-motion style="--retardo: 340ms;">
              <div><dt>Se abre en</dt><dd>el navegador</dd></div>
              <div><dt>Se entrega</dt><dd>SCORM o enlace</dd></div>
              <div><dt>Ejemplos acá</dt><dd>3</dd></div>
            </dl>
          </div>

          <!-- Tres capturas montadas como pilas de proyeccionista. Son las tres
               patas del servicio: el recorrido, el rodaje y la entrega. Bajo
               1240px desaparecen: apiladas repetirían lo que viene abajo. -->
          <div class="marquesina" aria-hidden="true">
            <figure class="mq mq--1">
              <div class="mq__barra"><i></i><i></i><i></i><em>Recorrido navegable</em></div>
              <img src="/assets/catalogo/tour360.webp" alt="" width="1100" height="688" loading="lazy" decoding="async" />
            </figure>
            <figure class="mq mq--2">
              <div class="mq__barra"><i></i><i></i><i></i><em>Rodaje en terreno</em></div>
              <img src="/assets/catalogo/terreno.webp" alt="" width="1100" height="619" loading="lazy" decoding="async" />
            </figure>
            <figure class="mq mq--3">
              <div class="mq__barra"><i></i><i></i><i></i><em>Entrega SCORM</em></div>
              <img src="/assets/catalogo/lms.webp" alt="" width="1100" height="688" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </section>

      <!-- ══ ESCENA 01 · Qué es, y en qué se diferencia de un video ═════════
           Era la única pregunta que la versión anterior no contestaba de
           frente, y es la primera que llega en la reunión. -->
      <section class="escena" id="diferencia">
        <p class="claqueta" data-motion>01 · Qué es</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">
          Un video se mira.<br /><em>Un recorrido se recorre.</em>
        </h2>
        <p class="parrafo" data-motion style="--retardo: 140ms;">
          Un recorrido 360 es la instalación capturada desde adentro, en puntos conectados
          entre sí, con la información montada encima. La persona se para en un punto, gira,
          se acerca a lo que le llama la atención y salta a la zona siguiente. No hay una
          línea de tiempo que la arrastre: la línea de tiempo la pone ella.
        </p>

        <div class="tabla" data-motion style="--retardo: 200ms;">
          <div class="tabla__cabeza" aria-hidden="true">
            <span></span>
            <span class="tabla__col">Video lineal</span>
            <span class="tabla__col tabla__col--viva">Recorrido 360</span>
          </div>
          {comparativa.map((f) => (
            <div class="tabla__fila">
              <p class="tabla__eje">{f.eje}</p>
              <p class="tabla__celda"><span class="tabla__rotulo">Video lineal</span>{f.video}</p>
              <p class="tabla__celda tabla__celda--viva"><span class="tabla__rotulo">Recorrido 360</span>{f.tour}</p>
            </div>
          ))}
        </div>

        <p class="nota" data-motion>
          Ninguno reemplaza al otro. El video explica un procedimiento mejor que cualquier
          recorrido; el recorrido ubica a la persona mejor que cualquier video. En la mayoría
          de los programas que producimos conviven, y por eso este servicio casi siempre se
          cotiza junto a producción en terreno.
        </p>
      </section>

      <!-- ══ ESCENA 02 · Para qué sirve ════════════════════════════════════ -->
      <section class="escena" id="usos">
        <p class="claqueta" data-motion>02 · Para qué sirve</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">
          Cuatro situaciones donde<br /><em>describir el lugar no alcanza.</em>
        </h2>

        <div class="usos" >
          {usos.map((u, i) => (
            <article class="uso" data-motion style={`--retardo: ${(i % 2) * 70}ms;`}>
              <p class="uso__n">{u.n}</p>
              <h3 class="uso__t">{u.t}</h3>
              <p class="uso__d">{u.d}</p>
              <p class="uso__detalle">{u.detalle}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ══ ESCENA 03 · Los ejemplos ══════════════════════════════════════
           Tres referencias, cada una con su naturaleza declarada en su propia
           tarjeta. La primera es tecnología de terceros y lo dice; la segunda
           es producción nuestra y va incrustada; la tercera es rodaje en
           terreno, que no es un 360 y también lo dice. -->
      <section class="escena escena--ancha" id="ejemplos">
        <p class="claqueta" data-motion>03 · Ejemplos</p>
        <h2 class="rubro" data-motion style="--retardo: 80ms;">
          Ábrelos acá mismo.<br /><em>Sin registro y sin descargar nada.</em>
        </h2>
        <p class="parrafo" data-motion style="--retardo: 140ms;">
          Dos de los tres corren dentro de esta página. El tercero se abre en Google Drive
          porque su visor no se deja incrustar en ningún sitio, y lo dice en su propio botón.
        </p>

        <div class="rollo">

          <!-- ── Referencia 01 · el tour de muestra ───────────────────────── -->
          <article class="banda" data-motion>
            <div class="banda__pantalla">
              <img
                src="/assets/catalogo/tour360.webp"
                alt="Portada de un recorrido virtual 360 de un centro de simulación médica, con el botón de inicio sobre la fachada del edificio"
                width="1100" height="688" loading="lazy" decoding="async"
              />
              <span class="banda__lupa" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </div>
            <div class="banda__cuerpo">
              <p class="banda__meta">
                <span class="banda__n">01</span>
                <span class="banda__grupo">Recorrido interactivo</span>
              </p>
              <h3 class="banda__titulo">Cómo se navega un recorrido por dentro</h3>
              <p class="banda__resumen">Puntos conectados, hotspots de información y saltos entre zonas.</p>
              <p class="banda__aviso">
                <b>Ojo:</b> es el tour de muestra de 3DVista, la tecnología con la que
                producimos — no un proyecto de Ewaffle. Lo dejamos acá porque es la forma más
                rápida de entender cómo se mueve una persona dentro de un recorrido.
              </p>
              <p class="banda__texto">
                Sirve para ver el mecanismo: cómo se pasa de una zona a otra, cómo aparece la
                información al tocar un punto y cómo se comporta en el celular. Cuando
                producimos el tuyo, lo que cambia es el contenido y el criterio con que se
                ordena el recorrido, no la forma de navegarlo.
              </p>
              <div class="banda__acciones">
                <button
                  type="button" class="pieza"
                  data-abrir="muestra" data-modo="iframe"
                  data-src="https://storage.net-fs.com/hosting/2727323/380/index.htm"
                  data-nota="Tour de muestra de 3DVista — la tecnología, no un proyecto nuestro"
                  data-pieza-nombre="Recorrido interactivo"
                  data-reel-titulo="Tour de muestra 3DVista"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  Abrir el recorrido acá
                </button>
                <a
                  class="pieza pieza--fuera"
                  href="https://storage.net-fs.com/hosting/2727323/380/index.htm"
                  target="_blank" rel="noopener noreferrer"
                >
                  Verlo a pantalla completa
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                  <span class="visually-hidden">(se abre en otra pestaña)</span>
                </a>
              </div>
            </div>
          </article>

          <!-- ── Referencia 02 · Planta Arauco ────────────────────────────
               Va incrustado y no detrás de un botón: es el único ejemplo de
               producción propia que se puede recorrer arrastrando, y esconderlo
               tras un clic sería esconder justo lo que la página viene a
               demostrar. `loading="lazy"` evita que el reproductor se cargue
               antes de que alguien baje hasta acá. -->
          <article class="banda banda--invertida" data-motion>
            <div class="banda__marco">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${araucoId}?rel=0&modestbranding=1`}
                title="Recorrido 360 · Logmeter Planta Arauco"
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen; xr-spatial-tracking"
                allowfullscreen
              ></iframe>
            </div>
            <div class="banda__cuerpo">
              <p class="banda__meta">
                <span class="banda__n">02</span>
                <span class="banda__grupo banda__grupo--propia">Producción propia</span>
              </p>
              <h3 class="banda__titulo">Planta Arauco · Logmeter</h3>
              <p class="banda__resumen">Recorrido en video 360 de una instalación industrial en operación.</p>
              <p class="banda__texto">
                Dale play y arrastra dentro del video: la vista gira. Es la misma mecánica que
                usa una persona en su inducción cuando quiere mirar hacia dónde va la línea o
                qué hay detrás del equipo, salvo que acá el recorrido avanza solo. Este formato
                conviene cuando el proceso está en movimiento y detenerlo para fotografiar cada
                punto no es una opción.
              </p>
              <ul class="banda__lista">
                <li>Se graba con la operación andando, sin parar la línea.</li>
                <li>Funciona en el navegador y con visor, arrastrando o girando la cabeza.</li>
                <li>Se puede acompañar con narración y con marcas sobre los puntos críticos.</li>
              </ul>
              <div class="banda__acciones">
                <a
                  class="pieza pieza--fuera"
                  href={`https://www.youtube.com/watch?v=${araucoId}`}
                  target="_blank" rel="noopener noreferrer"
                >
                  Abrirlo en YouTube
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                  <span class="visually-hidden">(se abre en otra pestaña)</span>
                </a>
              </div>
            </div>
          </article>

          <!-- ── Referencia 03 · producción en terreno ────────────────────── -->
          <article class="banda" data-motion>
            <div class="banda__pantalla">
              <img
                src="/assets/catalogo/terreno.webp"
                alt="Grabación en set: una persona hablando a cámara con iluminación de estudio"
