---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformLandingContent from '../components/platform/PlatformLandingContent.astro';

const title = "Plataforma LMS para empresas e instituciones privadas | Ewaffle";
const description = "Plataforma LMS base para empresas grandes e instituciones privadas. La customizamos con marca blanca, sistemas propios, journeys de onboarding, cursos gamificados, recursos e-learning y reportes.";
const canonicalUrl = "https://ewaffle.cl/lms";
const imageUrl = "https://ewaffle.cl/assets/logoprimario.png";
const keywords = "plataforma LMS para empresas, LMS corporativo, LMS marca blanca, plataforma educativa privada, academia corporativa, onboarding corporativo, cursos gamificados, recursos e-learning, integraciones LMS, instituciones privadas";
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Ewaffle" />
    <meta property="og:locale" content="es_ES" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
    <meta name="keywords" content={keywords} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Plataforma LMS personalizable",
      "provider": {
        "@type": "Organization",
        "name": "Ewaffle",
        "url": "https://ewaffle.cl",
        "logo": "https://ewaffle.cl/assets/logoprimario.png"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Chile y Latinoamerica"
      },
      "description": description,
      "name": title
    })} />
  </Fragment>

  <PlatformLandingContent />
</BaseLayout>
