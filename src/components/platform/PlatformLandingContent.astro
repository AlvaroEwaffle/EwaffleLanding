    motionItems.forEach(function (item, index) {
      if (item.classList.contains('motion-card')) {
        item.style.setProperty('--motion-delay', Math.min(index % 6, 5) * 70 + 'ms');
      }
      revealObserver.observe(item);
    });

    var ticking = false;
    function updateParallax() {
      var viewportHeight = window.innerHeight || 1;
      parallaxItems.forEach(function (item) {
        var rect = item.getBoundingClientRect();
        var depth = Number(item.getAttribute('data-parallax')) || 0.12;
        var progress = (rect.top + rect.height / 2 - viewportHeight / 2) / viewportHeight;
        var y = Math.max(-42, Math.min(42, progress * -120 * depth));
        item.style.setProperty('--parallax-y', y.toFixed(2) + 'px');
      });
      ticking = false;
    }

    function onScroll() {
      if (ticking) return;
      window.requestAnimationFrame(updateParallax);
