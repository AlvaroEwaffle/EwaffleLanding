---
import HeroElement from '../../assets/HeroElement.png';
import Contact from '../landing/Contact.astro';
import Footer from '../landing/Footer.astro';

const capabilities = [
  {
    icon: 'ri-palette-line',
    title: 'Marca blanca real',
    text: 'Logo, colores, fondo, favicon, mensaje de bienvenida y login por organizacion.',
  },
  {
    icon: 'ri-layout-grid-line',
    title: 'Cursos por desafios',
    text: 'Estructura los programas en desafios, etapas, lecciones, recursos, quizzes y examenes.',
  },
  {
    icon: 'ri-bar-chart-box-line',
    title: 'Dashboard operativo',
    text: 'Administra cursos, alumnos, avance, reportes y gestion de participantes desde una vista central.',
  },
  {
    icon: 'ri-award-line',
    title: 'Gamificacion integrada',
    text: 'Puntos, badges, rankings y progreso visual para aumentar continuidad y finalizacion.',
  },
  {
    icon: 'ri-links-line',
    title: 'Contenido flexible',
    text: 'Compatible con videos, PDFs, enlaces, H5P, Genially, quizzes, archivos y recursos externos.',
  },
  {
    icon: 'ri-user-settings-line',
    title: 'Roles y accesos',
    text: 'Experiencias separadas para alumnos, administradores y super administradores.',
  },
];

const differentiators = [
  {
    icon: 'ri-plug-line',
    title: 'Integracion con sistemas propios',
    text: 'Conectamos la plataforma a herramientas internas, CRM, intranet, HR, SSO, reportes o APIs para evitar que la LMS sea otra isla operativa.',
  },
  {
    icon: 'ri-route-line',
    title: 'Journeys y onboardings customizados',
    text: 'Diseñamos rutas por rol, etapa, cohorte o hito: onboarding, certificacion, academia comercial, partners o clientes.',
  },
  {
    icon: 'ri-gamepad-line',
    title: 'Gamificacion aplicada',
    text: 'Puntos, badges, rankings, misiones y progreso visual conectados a objetivos reales de aprendizaje y negocio.',
  },
  {
    icon: 'ri-movie-2-line',
    title: 'Recursos e-learning de alta calidad',
    text: 'La plataforma puede venir con cursos, videos, Storyline, Rise, Genially, 360, quizzes y simulaciones producidas por Ewaffle.',
  },
];

const resourceShowcase = [
  {
    icon: 'ri-video-line',
    label: 'Video animado',
    title: 'Capsulas audiovisuales para abrir o reforzar un modulo',
    text: 'Ideales para explicar conceptos, alinear expectativas y elevar la calidad percibida de la experiencia.',
    href: '/demo#video',
    cta: 'Ver demo de video',
  },
  {
    icon: 'ri-pages-line',
    label: 'Rise 360',
    title: 'Guias interactivas navegables',
    text: 'Perfectas para contenido consultable, manuales vivos, politicas, procedimientos y rutas de aprendizaje.',
    href: '/demo#rise',
    cta: 'Ver guia Rise',
  },
  {
    icon: 'ri-flow-chart',
    label: 'Storyline SCORM',
    title: 'Simulaciones y arboles de decision',
    text: 'Para practicar decisiones, evaluar criterios y registrar avance dentro de la LMS.',
    href: '/demo#game',
    cta: 'Ver recurso SCORM',
  },
  {
    icon: 'ri-slideshow-line',
    label: 'Genially e infografias',
    title: 'Piezas interactivas livianas',
    text: 'Buenos recursos para explicar procesos, comparar escenarios o dejar material de refuerzo.',
    href: '/demo#infographic',
    cta: 'Ver infografia',
  },
  {
    icon: 'ri-360-view',
    label: '360 y terreno',
    title: 'Experiencias inmersivas para espacios, procesos o seguridad',
    text: 'Recorridos, videos 360 y produccion en terreno para onboarding operativo o entrenamiento contextual.',
    href: '/catalogo',
    cta: 'Ver catalogo',
  },
  {
    icon: 'ri-stack-line',
    label: 'Mix de formatos',
    title: 'Combinaciones segun objetivo',
    text: 'Entrada rapida, modulo completo o experiencia inmersiva, con recursos elegidos por impacto y presupuesto.',
    href: '/catalogo',
    cta: 'Explorar recursos',
  },
];

const customizationLayers = [
  'Identidad visual y experiencia de ingreso',
  'Estructura de cursos, etapas y evaluaciones',
  'Reportes y seguimiento segun operacion del cliente',
  'Integraciones, dominios, automatizaciones y soporte',
];

const audiences = [
  {
    title: 'Empresas',
    text: 'Onboarding, compliance, seguridad, entrenamiento comercial y rutas internas de desarrollo.',
  },
  {
    title: 'Instituciones privadas',
    text: 'Universidades privadas, colegios, institutos, programas formativos, certificaciones y seguimiento de avance.',
  },
  {
    title: 'Academias corporativas',
    text: 'Academias internas, comerciales o de partners con marca propia, catalogo de cursos y experiencia diferenciada.',
  },
];

const implementation = [
  {
    step: '01',
    title: 'Diagnostico de uso',
    text: 'Definimos publico, cursos, volumen de usuarios, reglas de acceso y nivel de customizacion requerido.',
  },
  {
    step: '02',
    title: 'Activacion de base',
    text: 'Levantamos la plataforma base con branding, roles, cursos iniciales y flujos esenciales.',
  },
  {
    step: '03',
    title: 'Customizacion guiada',
    text: 'Ajustamos experiencia, reportes, contenidos, integraciones y detalles operativos del cliente.',
  },
  {
    step: '04',
    title: 'Salida a produccion',
    text: 'Validamos con usuarios piloto, corregimos fricciones y dejamos al equipo listo para operar.',
  },
];
---

<main class="motion-page min-h-screen overflow-x-hidden bg-white text-text-dark">
  <section class="motion-hero relative overflow-hidden bg-primary text-white" data-parallax-section>
    <div class="absolute inset-0 opacity-10">
      <img src="/assets/Patron.svg" alt="" class="h-full w-full object-cover" loading="eager" />
    </div>
    <div class="motion-field absolute inset-0 pointer-events-none" aria-hidden="true">
      <span class="motion-orbit motion-orbit--one"></span>
      <span class="motion-orbit motion-orbit--two"></span>
      <span class="motion-dash motion-dash--one"></span>
      <span class="motion-dash motion-dash--two"></span>
      <span class="motion-dot motion-dot--one"></span>
      <span class="motion-dot motion-dot--two"></span>
    </div>

    <div class="container relative mx-auto grid min-h-[92vh] max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:px-8">
      <div class="pt-8 lg:pt-12" data-motion="fade-up">
        <a href="/" class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-yellow">
          <img src="/assets/logoewchico.png" alt="Ewaffle" class="h-7 w-auto" />
          Plataforma LMS Ewaffle
        </a>

        <p class="mt-10 text-sm font-bold uppercase tracking-[0.18em] text-yellow">
          Plataforma base + journeys + contenido
        </p>
        <h1 class="mt-4 max-w-3xl text-4xl font-black leading-tight md:text-[2.9rem] lg:text-[3.35rem]">
          Tu plataforma de aprendizaje, conectada a tu operacion y disenada como experiencia.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/90 md:text-xl">
          Partimos de una LMS base y la customizamos con tu marca, tus sistemas, journeys de onboarding, gamificacion y recursos e-learning de alta calidad.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#contact" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-accent px-7 py-3 text-base font-bold text-white shadow-xl transition hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-yellow">
            Agendar demo de plataforma
          </a>
          <a href="#propuesta" class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-white/25 px-7 py-3 text-base font-bold text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-yellow">
            Ver propuesta
          </a>
        </div>

        <div class="mt-10 grid max-w-xl grid-cols-3 gap-3 text-center" data-motion="stagger">
          <div class="motion-card rounded-lg border border-white/15 bg-white/10 px-3 py-4">
            <div class="text-2xl font-black text-yellow">Base</div>
            <div class="mt-1 text-xs text-white/70">lista para activar</div>
          </div>
          <div class="motion-card rounded-lg border border-white/15 bg-white/10 px-3 py-4">
            <div class="text-2xl font-black text-yellow">100%</div>
            <div class="mt-1 text-xs text-white/70">marca propia</div>
          </div>
          <div class="motion-card rounded-lg border border-white/15 bg-white/10 px-3 py-4">
            <div class="text-2xl font-black text-yellow">Cursos</div>
            <div class="mt-1 text-xs text-white/70">listos para aprender</div>
          </div>
        </div>
      </div>

      <div class="relative" data-motion="float-in" data-parallax="0.16">
        <div class="motion-screen rounded-[28px] border border-white/15 bg-white p-3 shadow-2xl">
          <div class="overflow-hidden rounded-[22px] border border-slate-200 bg-slate-950">
            <div class="flex items-center justify-between border-b border-white/10 bg-slate-900 px-5 py-4">
              <div class="flex items-center gap-3">
                <div class="grid h-10 w-10 place-items-center rounded-xl bg-accent text-white">
                  <i class="ri-graduation-cap-line text-xl" aria-hidden="true"></i>
                </div>
                <div>
                  <p class="text-sm font-bold text-white">Academia cliente</p>
                  <p class="text-xs text-slate-400">Vista alumno y admin</p>
                </div>
              </div>
              <span class="rounded-full bg-emerald-400/15 px-3 py-1 text-xs font-bold text-emerald-200">Personalizable</span>
            </div>

            <div class="grid gap-4 p-5 md:grid-cols-[180px_1fr]">
              <aside class="rounded-2xl bg-slate-900 p-4">
                <div class="mb-5 h-9 w-28 rounded-lg bg-white/90"></div>
                <div class="space-y-3">
                  <div class="rounded-lg bg-accent px-3 py-2 text-sm font-bold text-white">Cursos</div>
                  <div class="rounded-lg bg-white/5 px-3 py-2 text-sm text-slate-300">Alumnos</div>
                  <div class="rounded-lg bg-white/5 px-3 py-2 text-sm text-slate-300">Reportes</div>
                  <div class="rounded-lg bg-white/5 px-3 py-2 text-sm text-slate-300">Branding</div>
                </div>
              </aside>

              <div class="space-y-4">
                <div class="grid gap-3 sm:grid-cols-3" data-motion="stagger">
                  <div class="motion-card rounded-xl bg-white p-4 text-slate-950">
                    <p class="text-xs font-bold uppercase text-slate-500">Cursos activos</p>
                    <p class="mt-2 text-3xl font-black">12</p>
                  </div>
                  <div class="motion-card rounded-xl bg-white p-4 text-slate-950">
                    <p class="text-xs font-bold uppercase text-slate-500">Avance medio</p>
                    <p class="mt-2 text-3xl font-black">74%</p>
                  </div>
                  <div class="motion-card rounded-xl bg-white p-4 text-slate-950">
                    <p class="text-xs font-bold uppercase text-slate-500">Badges</p>
                    <p class="mt-2 text-3xl font-black">38</p>
                  </div>
                </div>

                <div class="rounded-2xl bg-white p-5 text-slate-950">
                  <div class="mb-4 flex items-center justify-between">
                    <div>
                      <p class="text-xs font-bold uppercase text-slate-500">Ruta formativa</p>
                      <h2 class="text-xl font-black">Onboarding comercial</h2>
                    </div>
                    <span class="rounded-full bg-secondary/10 px-3 py-1 text-xs font-bold text-secondary">4 etapas</span>
                  </div>
                  <div class="space-y-3">
                    <div class="motion-progress-row flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50 p-3">
                      <i class="ri-play-circle-line text-2xl text-accent" aria-hidden="true"></i>
                      <div class="min-w-0 flex-1">
                        <p class="font-bold">Bienvenida y cultura</p>
                        <div class="mt-2 h-2 rounded-full bg-slate-200">
                          <div class="motion-progress h-2 w-4/5 rounded-full bg-accent"></div>
                        </div>
                      </div>
                    </div>
                    <div class="motion-progress-row flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50 p-3">
                      <i class="ri-question-answer-line text-2xl text-secondary" aria-hidden="true"></i>
                      <div class="min-w-0 flex-1">
                        <p class="font-bold">Quiz de producto</p>
                        <div class="mt-2 h-2 rounded-full bg-slate-200">
                          <div class="motion-progress h-2 w-3/5 rounded-full bg-secondary"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <img src={HeroElement.src} alt="Recursos digitales para experiencias e-learning" class="motion-hero-element absolute -bottom-16 -right-8 hidden w-40 drop-shadow-2xl lg:block" loading="eager" data-parallax="-0.24" />
      </div>
    </div>
  </section>

  <section id="propuesta" class="motion-section bg-gray-50 py-20" data-motion-section>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div data-motion="fade-right">
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-accent">La propuesta</p>
          <h2 class="mt-3 text-3xl font-black text-primary md:text-5xl">
            No vendemos solo software: dejamos una plataforma operando para tu organizacion.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-gray-600">
            La ventaja es partir desde una base probada y customizar solo lo que genera valor: marca, experiencia, cursos, reportes, integraciones y operacion. Eso reduce tiempo, riesgo y dependencia tecnica.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2" data-motion="stagger">
          {capabilities.map((item) => (
            <article class="motion-card rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <i class={`${item.icon} text-3xl text-accent`} aria-hidden="true"></i>
              <h3 class="mt-4 text-xl font-black text-primary">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-gray-600">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="motion-section bg-white py-20" data-motion-section>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center" data-motion="fade-up">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-secondary">Lo que mas llama la atencion</p>
        <h2 class="mt-3 text-3xl font-black text-primary md:text-5xl">
          La LMS se vuelve valiosa cuando vive dentro de la operacion del cliente.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-gray-600">
          Por eso la propuesta no es solo activar usuarios y cursos. Es disenar una experiencia conectada, medible y con recursos de aprendizaje que se sientan profesionales desde el primer dia.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4" data-motion="stagger">
        {differentiators.map((item) => (
          <article class="motion-card rounded-lg border border-gray-200 bg-gray-50 p-6">
            <span class="grid h-12 w-12 place-items-center rounded-lg bg-secondary/10 text-secondary">
              <i class={`${item.icon} text-2xl`} aria-hidden="true"></i>
            </span>
            <h3 class="mt-5 text-xl font-black text-primary">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="motion-section bg-white py-20" data-motion-section>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div class="rounded-[28px] border border-gray-200 bg-gray-50 p-6 md:p-8" data-motion="fade-right" data-parallax="0.08">
          <div class="rounded-2xl bg-primary p-5 text-white">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-yellow">Branding</p>
                <h3 class="mt-2 text-2xl font-black">Login por cliente</h3>
              </div>
              <i class="ri-palette-line text-4xl text-yellow" aria-hidden="true"></i>
            </div>
            <div class="mt-6 rounded-xl border border-white/15 bg-white/10 p-4">
              <div class="mb-4 h-12 w-36 rounded-lg bg-white"></div>
              <p class="text-xl font-black">Bienvenido a tu academia</p>
              <p class="mt-2 text-sm text-white/75">Mensaje, colores, fondo y logo adaptados a la organizacion.</p>
              <div class="mt-5 rounded-lg bg-accent px-4 py-3 text-center text-sm font-bold">Ingresar</div>
            </div>
          </div>
        </div>

        <div data-motion="fade-left">
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-secondary">Customizacion inteligente</p>
          <h2 class="mt-3 text-3xl font-black text-primary md:text-5xl">
            Base comun, experiencia propia.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-gray-600">
            El cliente no compra una herramienta generica. Compra una plataforma que se siente suya y que refleja su forma de operar, sin asumir el costo de desarrollar una LMS desde cero.
          </p>
          <ul class="mt-8 space-y-4" data-motion="stagger">
            {customizationLayers.map((item) => (
              <li class="motion-card flex gap-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-secondary/10 text-secondary">
                  <i class="ri-check-line text-xl" aria-hidden="true"></i>
                </span>
                <span class="font-semibold text-primary">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="motion-section bg-gray-50 py-20" data-motion-section>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div data-motion="fade-right">
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-accent">Recursos que pueden vivir dentro</p>
          <h2 class="mt-3 text-3xl font-black text-primary md:text-5xl">
            No dejamos una plataforma vacia: podemos llenarla con experiencias e-learning reales.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-gray-600">
            Revisamos la demo y el catalogo actual para traer a esta propuesta formatos concretos: video, Rise, Storyline SCORM, Genially, 360 y combinaciones de recursos segun objetivo.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/demo" class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-bold text-white transition hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-accent">
              Ver demo interactiva
            </a>
            <a href="/catalogo" class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-primary/20 px-6 py-3 text-sm font-bold text-primary transition hover:bg-primary/5 focus:outline-none focus:ring-2 focus:ring-accent">
              Ver catalogo de recursos
            </a>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2" data-motion="stagger">
          {resourceShowcase.map((item) => (
            <article class="motion-card rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <div class="flex items-start justify-between gap-4">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-accent/10 text-accent">
                  <i class={`${item.icon} text-2xl`} aria-hidden="true"></i>
                </span>
                <span class="rounded-full bg-primary/5 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-primary">{item.label}</span>
              </div>
              <h3 class="mt-4 text-lg font-black text-primary">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{item.text}</p>
              <a href={item.href} class="mt-4 inline-flex min-h-[44px] items-center text-sm font-bold text-accent transition hover:text-accent/80 focus:outline-none focus:ring-2 focus:ring-accent">
                {item.cta}
                <i class="ri-arrow-right-line ml-2" aria-hidden="true"></i>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="motion-section bg-white py-20" data-motion-section>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="motion-bundle overflow-hidden rounded-[28px] border border-primary/10 bg-primary text-white" data-motion="scale-in">
        <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
          <div class="p-8 md:p-12" data-motion="fade-right">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-yellow">Bundle recomendado</p>
            <h2 class="mt-3 text-3xl font-black leading-tight md:text-5xl">
              Plataforma + Cursos Gamificados
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-white/80">
              Para clientes que no quieren solo tecnologia: quieren salir a produccion con una academia propia, cursos listos y una experiencia que motive a completar.
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-3" data-motion="stagger">
              <div class="motion-card rounded-lg border border-white/15 bg-white/10 p-4">
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-yellow">Incluye</p>
                <p class="mt-2 font-bold">LMS customizada</p>
              </div>
              <div class="motion-card rounded-lg border border-white/15 bg-white/10 p-4">
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-yellow">Incluye</p>
                <p class="mt-2 font-bold">Cursos gamificados</p>
              </div>
              <div class="motion-card rounded-lg border border-white/15 bg-white/10 p-4">
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-yellow">Incluye</p>
                <p class="mt-2 font-bold">Implementacion guiada</p>
              </div>
            </div>
            <a href="#contact" class="mt-8 inline-flex min-h-[52px] items-center justify-center rounded-full bg-accent px-8 py-3 text-base font-bold text-white transition hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-yellow">
              Cotizar bundle
            </a>
          </div>

          <div class="bg-white p-6 text-primary md:p-8" data-motion="fade-left">
            <div class="grid h-full gap-4" data-motion="stagger">
