---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Plataformas y experiencias de aprendizaje e-learning para universidades, empresas e instituciones", 
  subtitle = "LMS marca blanca, Journeys de Onboarding Digital, cursos y cápsulas gamificadas: recursos e-learning premium." 
} = Astro.props;
---

<!-- Spinning Banner -->
<div class="fixed top-0 left-0 w-full bg-yellow/90 backdrop-blur-sm z-50">
  <div class="overflow-hidden">
    <div class="flex animate-scroll-banner whitespace-nowrap">
      <div class="flex items-center space-x-8 px-4 py-3 text-primary font-semibold">
        <span>Plataformas LMS marca blanca</span>
        <span>Journeys de onboarding customizados</span>
        <span>Integración con sistemas propios</span>
        <span>Cursos gamificados SCORM listos</span>
        <span>Recursos e-learning premium</span>
        <span>Implementación guiada</span>
        <span>Plataformas LMS marca blanca</span>
        <span>Journeys de onboarding customizados</span>
        <span>Integración con sistemas propios</span>
        <span>Cursos gamificados SCORM listos</span>
        <span>Recursos e-learning premium</span>
        <span>Implementación guiada</span>
      </div>
    </div>
  </div>
</div>

<!-- Sin alto propio: el wrapper de index.astro hace que Hero + CatalogBanner ocupen
     exactamente una pantalla. flex-1 es lo que reparte el sobrante al hero. -->
<section class="relative flex-1 flex items-center justify-center text-center bg-gradient-to-b from-primary to-primary/90 overflow-hidden pt-14 pb-8">
  <!-- Enhanced Background Elements -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Floating Dots with different animations -->
    <div class="absolute top-20 left-10 w-2 h-2 bg-yellow/30 rounded-full animate-bounce"></div>
    <div class="absolute top-40 right-20 w-3 h-3 bg-accent/30 rounded-full animate-pulse"></div>
    <div class="absolute bottom-40 left-20 w-2 h-2 bg-secondary/30 rounded-full animate-bounce"></div>
    <div class="absolute bottom-20 right-10 w-3 h-3 bg-yellow/30 rounded-full animate-pulse"></div>
    
    <!-- Additional floating elements -->
    <div class="absolute top-1/3 left-1/6 w-1 h-1 bg-white/40 rounded-full animate-ping"></div>
    <div class="absolute top-2/3 right-1/6 w-2 h-2 bg-accent/40 rounded-full animate-bounce"></div>
    <div class="absolute top-1/4 right-1/3 w-1.5 h-1.5 bg-secondary/40 rounded-full animate-pulse"></div>
    <div class="absolute bottom-1/3 left-1/3 w-1 h-1 bg-yellow/40 rounded-full animate-ping"></div>
    
    <!-- Geometric Shapes with varied animations -->
    <div class="absolute top-32 left-1/4 w-16 h-16 border border-white/10 rounded-full animate-spin"></div>
    <div class="absolute bottom-32 right-1/4 w-20 h-20 border border-accent/20 rounded-lg animate-pulse"></div>
    <div class="absolute top-1/2 left-1/5 w-12 h-12 border border-white/5 rotate-45 animate-spin"></div>
    <div class="absolute top-1/3 right-1/5 w-8 h-8 border border-accent/15 rounded-full animate-pulse"></div>
    <div class="absolute bottom-1/4 left-1/2 w-16 h-16 border border-secondary/10 rounded-lg animate-spin"></div>
    
    <!-- Gradient Orbs for depth -->
    <div class="absolute top-1/6 right-1/4 w-24 h-24 bg-gradient-to-br from-accent/20 to-transparent rounded-full animate-pulse blur-xl"></div>
    <div class="absolute bottom-1/6 left-1/4 w-32 h-32 bg-gradient-to-tr from-secondary/20 to-transparent rounded-full animate-pulse blur-xl"></div>
    <div class="absolute top-1/2 left-1/2 w-40 h-40 bg-gradient-to-br from-yellow/10 to-transparent rounded-full animate-pulse blur-2xl"></div>
    
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5">
      <img src="/assets/Patron.svg" alt="" class="w-full h-full object-cover" />
    </div>
    
    <!-- Subtle moving lines -->
    <div class="absolute top-1/4 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent animate-pulse"></div>
    <div class="absolute bottom-1/4 left-0 w-full h-px bg-gradient-to-r from-transparent via-accent/20 to-transparent animate-pulse"></div>
    
    <!-- Corner accents -->
    <div class="absolute top-0 left-0 w-32 h-32 border-l-2 border-t-2 border-white/10 animate-pulse"></div>
    <div class="absolute top-0 right-0 w-32 h-32 border-r-2 border-t-2 border-white/10 animate-pulse"></div>
    <div class="absolute bottom-0 left-0 w-32 h-32 border-l-2 border-b-2 border-white/10 animate-pulse"></div>
    <div class="absolute bottom-0 right-0 w-32 h-32 border-r-2 border-b-2 border-white/10 animate-pulse"></div>
  </div>

  <div class="relative z-30 max-w-6xl mt-20 px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="mb-4 flex justify-center">
      <img 
        src="/assets/logoprimario.png" 
        alt="Ewaffle Logo" 
        class="w-56 lg:w-64 h-auto object-contain"
      />
    </div>

    <!-- Main Title - H1 optimizado -->
    <h1 class="text-white text-3xl md:text-4xl lg:text-5xl mb-4 drop-shadow-lg font-bold leading-tight max-w-5xl mx-auto">
      {title}
    </h1>

    <!-- Subtitle con refuerzo concreto -->
    <p class="text-white text-xl md:text-2xl max-w-4xl mx-auto mb-8 leading-relaxed">
      {subtitle}
    </p>

    <!-- CTA Principal - Botón contrastante -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
      <a
        href="#contact"
        id="hero-cta-link"
        class="inline-flex items-center justify-center px-9 py-4 bg-accent text-white rounded-full font-semibold text-lg hover:bg-accent/90 transition-all duration-300 shadow-2xl hover:shadow-accent/25 hover:scale-105 transform"
      >
        Conversemos sobre tu proyecto
      </a>
    </div>

    <!-- Prueba Social Inmediata -->
    <div>
      <p class="text-white/90 text-base mb-3">
        <span class="font-semibold">+50 empresas</span> ya confían en nosotros
      </p>
      
      <!-- Logos de clientes destacados -->
      <!-- Dos tipos de chip a proposito: los logos en color u oscuros (ACHS, AIEP, LATAM,
           UNIACC, Coanil, Buffalo) van sobre chip claro; los que vienen en blanco
           (Duoc UC, UST, Gabriela Mistral) sobre chip oscuro. Un solo fondo hace
           desaparecer a la mitad de las marcas. -->
      <div class="flex flex-wrap justify-center items-center gap-2.5 mb-4">
        <div class="bg-white/95 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/ACHS.svg" alt="ACHS" class="h-6 w-auto" />
        </div>
        <div class="bg-white/95 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/AIEP.svg" alt="AIEP" class="h-6 w-auto" />
        </div>
        <div class="bg-white/10 border border-white/20 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/Duoc UC.svg" alt="Duoc UC" class="h-6 w-auto" />
        </div>
        <div class="bg-white/10 border border-white/20 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/UST.svg" alt="Universidad Santo Tomás" class="h-6 w-auto" />
        </div>
        <div class="bg-white/95 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/LATAM.svg" alt="LATAM Airlines" class="h-5 w-auto" />
        </div>
        <div class="bg-white/95 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/UNIACC.svg" alt="UNIACC" class="h-6 w-auto" />
        </div>
        <div class="bg-white/10 border border-white/20 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/Universidad Gabriela Mistral.svg" alt="Universidad Gabriela Mistral" class="h-6 w-auto" />
        </div>
        <div class="bg-white/95 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/Coanil.png" alt="Coanil" class="h-7 w-auto" />
        </div>
        <div class="bg-white/95 rounded-lg px-3.5 py-1.5 flex items-center justify-center transition-all duration-300 hover:scale-105">
          <img src="/assets/clientlogos/Buffalo.webp" alt="Buffalo Waffles" class="h-7 w-auto" />
        </div>
      </div>
      </div>
      
      <p class="text-white/80 text-base max-w-2xl mx-auto leading-relaxed">
        Implementamos la experiencia completa sin que armes equipo interno.
      </p>
    </div>
  </div>
  <!-- Invitacion a bajar. Sutil a proposito: si compite con el CTA, le roba el clic. -->
  <a href="#proceso" aria-label="Ver mas" class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 text-white/35 hover:text-white/70 transition-colors duration-300">
    <svg class="w-6 h-6 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('hero-cta-link')?.addEventListener('click', function () {
      window.ewaffleAnalytics?.ctaClick({
        buttonText: 'Conversemos sobre tu Proyecto',
        section: 'hero',
        position: 'primary',
        destination: '#contact',
      });
    });
  });
</script>

<style>
  @keyframes scroll-banner {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  
  .animate-scroll-banner {
    animation: scroll-banner 15s linear infinite;
  }
</style>
