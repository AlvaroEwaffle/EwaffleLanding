---
// Banner del servicio estándar Onboarding Digital.
//
// Es un paquete con alcance y precio cerrados, no un proyecto a medida: por eso
// el banner muestra los tres planes con su equivalencia en jornada presencial.
// Esa equivalencia es el criterio de elección — quien sabe cuánto dura su
// inducción de hoy, ya sabe qué plan le corresponde.

const planes = [
  {
    nombre: "Esencial",
    jornada: "~2 horas presenciales",
    incluye: "Video de contenido, guía interactiva de 6 capítulos y material descargable.",
    destacado: false,
  },
  {
    nombre: "Estándar",
    jornada: "~4 horas presenciales",
    incluye: "Suma la cápsula de decisión ramificada y la evaluación certificadora.",
    destacado: true,
  },
  {
    nombre: "Intensivo",
    jornada: "~8 horas presenciales",
    incluye: "Dos videos, dos guías y dos cápsulas de decisión.",
    destacado: false,
  },
];
---

<section id="onboarding-digital" class="py-20 lg:py-24 bg-primary relative overflow-hidden">
  <div class="absolute -top-24 -left-16 h-72 w-72 rounded-full bg-accent/15 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 right-0 h-80 w-80 rounded-full bg-yellow/10 blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl mb-12">
      <span class="inline-block text-yellow font-mono text-sm tracking-[0.18em] uppercase mb-4">Servicio estándar</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-5">
        Onboarding Digital: la inducción de tu empresa, en e-learning
      </h2>
      <p class="text-lg md:text-xl text-white/80 leading-relaxed">
        La jornada de inducción presencial, convertida en un módulo e-learning que reemplaza o
        complementa lo que hoy hacen en sala. La misma inducción para todos, entren cuando entren,
        con registro de quién la completó.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3 mb-10">
      {planes.map((p) => (
        <div class={`rounded-2xl p-6 border transition-all duration-300 hover:scale-[1.02] ${p.destacado ? 'bg-white/10 border-accent/50' : 'bg-white/5 border-white/10'}`}>
          <div class="flex items-baseline justify-between mb-2">
            <h3 class="text-xl font-bold text-white">{p.nombre}</h3>
            {p.destacado && (
              <span class="text-xs font-semibold text-accent bg-accent/15 border border-accent/40 rounded-full px-3 py-1">Recomendado</span>
            )}
          </div>
          <p class="font-mono text-sm text-yellow mb-3">{p.jornada}</p>
          <p class="text-white/75 text-sm leading-relaxed">{p.incluye}</p>
        </div>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-8">
      <a
        href="#contact"
        id="onboarding-digital-cta"
        class="inline-flex shrink-0 items-center justify-center gap-2 px-8 py-4 bg-yellow text-primary rounded-full font-semibold hover:bg-yellow/90 hover:scale-[1.02] transition-all duration-300 shadow-lg"
      >
        Cotizar mi onboarding
        <span aria-hidden="true">→</span>
      </a>
      <p class="text-white/70 text-sm leading-relaxed max-w-xl">
        Diez semanas desde el kick-off, con tres rondas de ajuste incluidas. Entrega en SCORM o HTML,
        para cargar en el LMS que ya tengan o en el nuestro.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('onboarding-digital-cta')?.addEventListener('click', function () {
      window.ewaffleAnalytics?.ctaClick({
        buttonText: 'Cotizar mi onboarding',
        section: 'onboarding_digital_banner',
        position: 'primary',
        destination: '#contact',
      });
    });
  });
</script>
