---
interface UseCase {
  title: string;
  description: string;
  icon: string;
  services: string[];
  industry: string;
}

const useCases: UseCase[] = [
  {
    title: "Capacitación Corporativa",
    description: "Creamos programas completos de onboarding, compliance y desarrollo profesional con trazabilidad, engagement y contenido alineado a tus procesos internos.",
    icon: "🏢",
    services: ["Plataforma LMS", "Cursos Gamificados", "Certificaciones"],
    industry: "Empresas"
  },
  {
    title: "Instituciones Privadas de Educación",
    description: "Ayudamos a universidades privadas, colegios, institutos y centros de formación a gestionar programas digitales con marca, reportería y experiencias de alto estándar.",
    icon: "🎓",
    services: ["Plataforma LMS", "Producción Multimedia", "Chatbots IA"],
    industry: "Educación"
  },
  {
    title: "Academias Corporativas",
    description: "Construimos academias internas, comerciales o de partners para que tus equipos, clientes y canales aprendan con una plataforma propia y contenidos reutilizables.",
    icon: "📚",
    services: ["Cursos Gamificados", "Plataforma LMS", "Gamificación"],
    industry: "E-learning"
  },
  {
    title: "Programas de Certificación",
    description: "Gestiona credenciales verificables para colaboradores, alumnos, partners o clientes, con evidencia de avance y finalización cuando necesitas control operacional.",
    icon: "🏅",
    services: ["Certificaciones", "Plataforma LMS", "Gamificación"],
    industry: "Certificación"
  },
  {
    title: "Capacitación en Compliance",
    description: "Mantén a tu equipo actualizado en normativas y procedimientos con cursos que cumplen todos los estándares y son fáciles de seguir.",
    icon: "📋",
    services: ["Cursos SCORM", "Certificaciones", "Producción Multimedia"],
    industry: "Compliance"
  },
  {
    title: "Desarrollo de Habilidades",
    description: "Crea programas de desarrollo profesional y habilidades blandas donde las personas puedan ver su progreso en tiempo real y mantenerse motivadas.",
    icon: "💼",
    services: ["Plataforma LMS", "Gamificación", "Chatbots IA"],
    industry: "Desarrollo"
  }
];
---

<section class="py-20 bg-gray-50 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5 pointer-events-none">
    <img src="/assets/patronblancobajaopacidad.png" alt="" class="w-full h-full object-cover" />
  </div>
  
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-primary mb-6">
        🎯 Conoce cómo te podemos ayudar
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
        ¿Te preguntas si nuestras soluciones encajan con tu industria? Aquí te mostramos cómo empresas como la tuya están transformando su capacitación digital
      </p>
      <div class="w-24 h-1 bg-accent mx-auto rounded-full"></div>
    </div>

    <!-- Use Cases - Uniform Grid Style -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
      {useCases.map((useCase, index) => {
        const gradients = [
          "from-primary via-primary/80 to-accent",
          "from-accent via-accent/80 to-secondary",
          "from-secondary via-secondary/80 to-yellow",
          "from-yellow via-yellow/80 to-primary",
          "from-primary via-accent/80 to-secondary",
          "from-accent via-yellow/80 to-primary"
        ];
        const gradient = gradients[index % gradients.length];
        
        return (
          <div class="group relative overflow-hidden rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 h-full">
            <!-- Gradient Background -->
            <div class={`absolute inset-0 bg-gradient-to-br ${gradient} opacity-90 group-hover:opacity-100 transition-opacity duration-300`}></div>
            
            <!-- Content -->
            <div class="relative p-8 md:p-10 text-white h-full flex flex-col justify-between min-h-[320px]">
              <!-- Top Section -->
              <div>
                <!-- Icon and Industry Badge -->
                <div class="flex items-start justify-between mb-6">
                  <div class="text-6xl md:text-7xl opacity-90 group-hover:scale-110 transition-transform duration-300">
                    {useCase.icon}
                  </div>
                  <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1 rounded-full border border-white/30">
                    {useCase.industry}
                  </span>
                </div>
                
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-4 group-hover:text-yellow transition-colors duration-300">
                  {useCase.title}
                </h3>
                
                <p class="text-white/90 text-base md:text-lg leading-relaxed mb-6">
                  {useCase.description}
                </p>
              </div>
              
              <!-- Services Tags -->
              <div class="mt-auto">
                <p class="text-white/80 text-sm font-semibold mb-3">Servicios utilizados:</p>
                <div class="flex flex-wrap gap-2">
                  {useCase.services.map((service) => (
                    <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-medium px-3 py-1.5 rounded-full border border-white/30 hover:bg-white/30 transition-colors">
                      {service}
                    </span>
                  ))}
                </div>
              </div>
              
              <!-- Hover Effect Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- CTA Section -->
    <div class="text-center mt-12">
      <p class="text-gray-600 mb-6 text-lg">
        ¿Tu caso de uso es diferente? ¡No te preocupes! Cada proyecto es único y nos encanta encontrar soluciones personalizadas.
      </p>
      <a 
        href="#contact"
        class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white rounded-full font-semibold text-lg hover:bg-primary/90 transition-all duration-300 shadow-lg hover:shadow-xl"
      >
        Hablemos de tu Proyecto - Es Gratis
      </a>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
</style>
