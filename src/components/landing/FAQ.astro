---
interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  // Cursos Gamificados
  {
    question: "¿Cuánto cuesta transformar mis cursos?",
    answer: "El costo varía según la cantidad y complejidad de tus cursos. Ofrecemos planes desde $1500 USD por curso completo. Agenda una reunión gratuita para recibir una cotización personalizada sin compromiso."
  },
  {
    question: "¿Los cursos funcionarán en mi LMS actual?",
    answer: "Sí, todos nuestros cursos son compatibles con estándares SCORM y funcionan en cualquier plataforma LMS del mercado (Moodle, Canvas, Blackboard, etc.). Si no tienes LMS, te damos uno."
  },
  {
    question: "¿Realmente no necesito equipo técnico interno?",
    answer: "Correcto. Nosotros manejamos el diseño, la producción SCORM, la implementación de plataforma y la coordinación técnica. Tu equipo puede enfocarse en operar y escalar la formación."
  },
  
  // Plataforma LMS
  {
    question: "¿Qué incluye la plataforma LMS de Ewaffle?",
    answer: "Nuestra plataforma LMS incluye gestión de usuarios, creación de desafíos y etapas, seguimiento de progreso, sistema de gamificación integrado, soporte para múltiples tipos de contenido (video, H5P, Genially, quizzes), programación automática y notificaciones. Todo listo para usar sin desarrollo técnico."
  },
  {
    question: "¿Puedo personalizar la plataforma LMS con mi marca?",
    answer: "Sí, ofrecemos marca blanca completa. Tu logo, colores e identidad visual se integran en toda la plataforma. Ewaffle queda invisible en el backend, tus usuarios solo ven tu marca."
  },
  {
    question: "¿Cuántos usuarios puede soportar la plataforma LMS?",
    answer: "Nuestra plataforma es escalable desde 10 hasta 10,000+ usuarios. Se adapta al crecimiento de tu organización sin problemas de rendimiento."
  },
  {
    question: "¿Se integra con nuestros sistemas internos?",
    answer: "Sí. Podemos integrar la plataforma con sistemas propios, RRHH, CRM, intranet, SSO, reportería y flujos de datos según el nivel de customización que necesite el proyecto."
  },
  
  // Chatbots IA
  {
    question: "¿Cómo funcionan los chatbots IA para cursos?",
    answer: "Utilizamos tecnología RAG (Retrieval Augmented Generation) que permite a los chatbots responder preguntas basándose en el contenido de tus cursos. Los chatbots están disponibles 24/7, reducen la carga de soporte en hasta 80% y mejoran la experiencia de aprendizaje."
  },
  {
    question: "¿Puedo entrenar el chatbot con mi propio contenido?",
    answer: "Sí, el chatbot se entrena específicamente con el contenido de tus cursos y materiales. Puedes actualizar la información cuando quieras y el chatbot aprenderá automáticamente."
  },
  
  // Gamificación
  {
    question: "¿Qué incluye el sistema de gamificación?",
    answer: "Nuestro sistema incluye puntos, badges, rankings, contenido desbloqueable tipo videojuego, progresión por niveles y logros. Esto aumenta el engagement hasta 3x y mejora las tasas de finalización de cursos."
  },
  {
    question: "¿La gamificación funciona con cualquier LMS?",
    answer: "Sí, nuestro sistema de gamificación puede integrarse con la mayoría de plataformas LMS del mercado, o puedes usar nuestra plataforma LMS que ya incluye gamificación nativa."
  },
  
  // Producción Multimedia
  {
    question: "¿Qué tipos de contenido multimedia pueden producir?",
    answer: "Producimos videos profesionales, contenido interactivo (Genially, H5P), audio de alta calidad con text-to-speech, diseño gráfico, animaciones y más. Todo adaptado a tus necesidades educativas."
  },
  {
    question: "¿Cuánto tiempo toma producir contenido multimedia?",
    answer: "Depende del tipo y complejidad del contenido. Videos simples pueden estar listos en 1-2 semanas, mientras que proyectos más complejos pueden tomar 3-4 semanas. Siempre trabajamos con plazos acordados previamente."
  },
  
  // Certificaciones
  {
    question: "¿Cómo funcionan las certificaciones digitales?",
    answer: "Ofrecemos certificaciones digitales verificables con códigos QR, evidencia de avance y personalización de marca. También podemos adaptar flujos de cumplimiento interno, auditoría o normativa específica cuando aplique."
  },
  
  // General
  {
    question: "¿Qué pasa si no estoy satisfecho con el resultado?",
    answer: "Ofrecemos garantía de 6 meses de soporte y ajustes ilimitados. Si no estás 100% satisfecho, trabajamos hasta que lo estés. Tu éxito es nuestro éxito."
  },
  {
    question: "¿Puedo cancelar o cambiar el proyecto en cualquier momento?",
    answer: "Sí, puedes cancelar en cualquier momento sin penalización. Trabajamos por fases, por lo que solo pagas por lo que ya está entregado y aprobado."
  },
  {
    question: "¿Atienden empresas fuera de Chile?",
    answer: "Sí, trabajamos con empresas en toda Latinoamérica. Nuestras soluciones están diseñadas para funcionar en cualquier país de la región, adaptándonos a las normativas locales cuando sea necesario."
  }
];
---

<section class="py-20 bg-gray-50 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5 pointer-events-none">
    <img src="/assets/patronblancofullopacidad.png" alt="" class="w-full h-full object-cover" />
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-primary mb-6">
        💬 Resolvemos tus dudas
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
        Resolvemos las dudas más comunes que podrían estar frenando tu decisión
      </p>
      <div class="w-24 h-1 bg-accent mx-auto rounded-full"></div>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid gap-6">
        {
          faqs.map((faq, index) => (
            <div class="faq-item bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-all duration-300">
              <button
                class="faq-question w-full p-8 text-left flex items-start justify-between group"
                aria-expanded="false"
                data-faq-index={index}
              >
                <div class="flex items-start flex-1">
                  <div class="flex-shrink-0 mt-1">
                    <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center group-hover:bg-accent/20 transition-colors duration-300">
                      <span class="text-accent text-xl font-bold">{index + 1}</span>
                    </div>
                  </div>
                  <div class="ml-6 flex-1">
                    <h3 class="text-xl font-bold text-primary group-hover:text-accent transition-colors duration-300">
                      {faq.question}
                    </h3>
                  </div>
                </div>
                <div class="flex-shrink-0 ml-4">
                  <i class="ri-arrow-down-s-line faq-icon text-2xl text-gray-400 group-hover:text-accent transition-all duration-300"></i>
                </div>
              </button>
              <div class="faq-answer overflow-hidden">
                <div class="px-8 pb-8 pl-14 md:pl-20">
                  <p class="text-gray-600 leading-relaxed text-lg">
                    {faq.answer}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach((item) => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      const icon = item.querySelector('.faq-icon');
      
      if (!question || !answer || !icon) return;
      
      // Set initial state (closed)
      answer.style.maxHeight = '0';
      answer.style.opacity = '0';
      
      question.addEventListener('click', () => {
        const isExpanded = question.getAttribute('aria-expanded') === 'true';
        
        // Close all other items
        faqItems.forEach((otherItem) => {
          if (otherItem !== item) {
            const otherQuestion = otherItem.querySelector('.faq-question');
            const otherAnswer = otherItem.querySelector('.faq-answer');
            const otherIcon = otherItem.querySelector('.faq-icon');
            
            if (otherQuestion && otherAnswer && otherIcon) {
              otherQuestion.setAttribute('aria-expanded', 'false');
              otherAnswer.style.maxHeight = '0';
              otherAnswer.style.opacity = '0';
              otherIcon.style.transform = 'rotate(0deg)';
            }
          }
        });
        
        // Toggle current item
        if (isExpanded) {
          question.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = '0';
          answer.style.opacity = '0';
          icon.style.transform = 'rotate(0deg)';
        } else {
          question.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          answer.style.opacity = '1';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>

<style>
  .faq-question {
    cursor: pointer;
    outline: none;
  }
  
  .faq-question:focus {
    outline: 2px solid var(--accent-color, #FF6B6B);
    outline-offset: -2px;
    border-radius: 1rem;
  }
  
  .faq-answer {
    max-height: 0;
    opacity: 0;
    transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
  }
  
  .faq-icon {
    transition: transform 0.3s ease-out;
  }
  
  .container {
    max-width: 1200px;
  }
</style> 
